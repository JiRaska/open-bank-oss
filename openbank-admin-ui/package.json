{
  "name": "openbank-admin-ui",
  "version": "0.226.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/generate-product-catalog-v2-types.mjs && node scripts/collect-prod-readiness.mjs && node scripts/generate-origination-graph.mjs && node scripts/generate-events.mjs",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "generate:app-status": "node scripts/generate-app-status.mjs",
    "pretype-check": "node scripts/generate-product-catalog-v2-types.mjs && node scripts/generate-origination-graph.mjs",
    "generate:catalog-types": "node scripts/generate-product-catalog-v2-types.mjs",
    "type-check": "tsc --noEmit",
    "pretest": "node scripts/generate-product-catalog-v2-types.mjs && node scripts/generate-governance.mjs && node scripts/generate-catalog.mjs && node scripts/generate-origination-graph.mjs && node scripts/generate-events.mjs",
    "test": "vitest run",
    "pretest:coverage": "npm run pretest",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
