{
  "name": "openbank-admin-ui",
  "version": "3.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-gate-catalog.mjs && node scripts/generate-platform-versions.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/generate-product-catalog-v2-types.mjs && node scripts/collect-prod-readiness.mjs && node scripts/generate-origination-graph.mjs && node scripts/generate-events.mjs && node scripts/generate-card-capabilities.mjs && node scripts/generate-gate-catalog.mjs && node scripts/generate-platform-versions.mjs",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "generate:app-status": "node scripts/generate-app-status.mjs",
    "pretype-check": "node scripts/generate-product-catalog-v2-types.mjs && node scripts/generate-origination-graph.mjs && node scripts/generate-platform-versions.mjs",
    "generate:catalog-types": "node scripts/generate-product-catalog-v2-types.mjs",
    "type-check": "tsc --noEmit",
    "pretest": "node --test scripts/approval-inbox-evidence.test.mjs && node scripts/generate-product-catalog-v2-types.mjs && node scripts/generate-governance.mjs && node scripts/generate-catalog.mjs && node scripts/generate-origination-graph.mjs && node scripts/generate-events.mjs && node scripts/generate-card-capabilities.mjs && node scripts/generate-gate-catalog.mjs && node scripts/generate-platform-versions.mjs",
    "test": "vitest run",
    "test:contract": "vitest run src/test/*-pact.contract.test.ts",
    "pretest:coverage": "npm run pretest",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "pretest:e2e": "node scripts/generate-gate-catalog.mjs && node scripts/generate-platform-versions.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-web": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-separator": "1.1.16",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-toast": "1.2.24",
    "@sentry/nextjs": "^11.6.0",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dompurify": "^3.4.16",
    "lucide-react": "1.54.0",
    "mermaid": "^12.1.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.89.0",
    "react-is": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "recharts": "3.10.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "xml2js": "^0.6.2",
    "yaml": "^2.9.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "katex": "0.18.2",
    "lodash-es": "4.18.1",
    "postcss": "8.5.29",
    "sharp": "0.35.5",
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@pact-foundation/pact": "17.1.4",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.2",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  }
}
