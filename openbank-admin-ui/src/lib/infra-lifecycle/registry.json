    {
      "id": "postgres",
      "eolProduct": "postgresql",
      "versionSource": "gitops",
      "imageGrep": "cloudnative-pg/postgresql",
      "releaseNotes": "https://www.postgresql.org/docs/release/{version}/"
    },
    {
      "id": "kafka",
      "eolProduct": "apache-kafka",
      "versionSource": "unknown",
      "releaseNotes": "https://kafka.apache.org/downloads"
    },
