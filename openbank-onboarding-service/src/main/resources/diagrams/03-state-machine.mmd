%% title: Onboarding Funnel Stage State Machine
stateDiagram-v2
  [*] --> PENDING_KYC : PARTY_CREATED

  PENDING_KYC --> KYC_IN_PROGRESS : KYC_CASE_OPENED

  KYC_IN_PROGRESS --> KYC_IN_PROGRESS : KYC_CASE_STATUS_CHANGED

  KYC_IN_PROGRESS --> PENDING_SCA : KYC_CASE_APPROVED\n(kycStatus=APPROVED)

  KYC_IN_PROGRESS --> BLOCKED : KYC_CASE_REJECTED\n(blockedReason set)

  PENDING_KYC --> BLOCKED : PARTY_STATUS_CHANGED\n(status=BLOCKED)

  PENDING_SCA --> ACTIVE : DEVICE_ENROLLED\n(scaEnrolled=true)

  PENDING_SCA --> BLOCKED : PARTY_STATUS_CHANGED\n(status=BLOCKED)

  BLOCKED --> PENDING_KYC : PARTY_STATUS_CHANGED\n(status unblocked)

  ACTIVE --> BLOCKED : PARTY_STATUS_CHANGED\n(status=BLOCKED)

  ACTIVE --> [*] : fully onboarded
