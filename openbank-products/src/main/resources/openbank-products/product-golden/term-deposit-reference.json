{
  "name": "term-deposit-reference",
  "description": "TERM-DEPOSIT-12M on 10 000 EUR opened 2026-01-01; maturity scheduled 2027-01-01. Hand-derived: one day of the 2 % band at ACT/360 accrues 10000 x 0.02 / 360 = 0.555556 (scale 6, HALF_UP). A 10000.01 withdrawal projects 10000.00 - 10000.01 = -0.01 < 0.00, so posting.no-overdraft refuses it with INSUFFICIENT_FUNDS and, the interpreter keeping only the Reject, no penalty. A full 10000.00 withdrawal before maturity projects 0.00 >= 0 and passes posting.no-overdraft, but its 1 % penalty of 100.00 would overdraw the deposit, so posting.early-withdrawal refuses it with INSUFFICIENT_FUNDS. A 1000.00 withdrawal before maturity projects 9000.00 >= 0, so it passes and pays 1000.00 x 0.01 = 10.00. Maturity capitalises 0.555556 HALF_UP to the cent = 0.56. A withdrawal after maturity carries no penalty.",
  "revision": {
    "irVersion": 1,
    "productCode": "TERM-DEPOSIT-12M",
    "currency": "EUR",
    "interest": {
      "ruleId": "interest.base",
      "rateType": "TIERED",
      "tiers": [
        {
          "from": "0.00",
          "to": "10000.00",
          "rate": "0.0200"
        },
        {
          "from": "10000.00",
          "rate": "0.0300"
        }
      ],
      "dayCount": "ACT_360",
      "accrualCadence": "DAILY",
      "capitalisationCadence": "AT_MATURITY",
      "accrualRounding": "INTEREST_ACCRUAL",
      "postingRounding": "LEDGER_POSTING"
    },
    "termDeposit": {
      "ruleId": "term.main",
      "termMonths": 12,
      "maturityAction": "CAPITALISE",
      "earlyWithdrawal": {
        "ruleId": "term.early-withdrawal",
        "kind": "RATE",
        "rate": "0.0100"
      }
    },
    "hooks": {
      "onOpen": [
        {
          "ruleId": "open.schedule-accrual",
          "action": {
            "type": "SCHEDULE",
            "hook": "scheduled",
            "tag": "ACCRUAL",
            "cadence": "DAILY"
          }
        },
        {
          "ruleId": "open.schedule-maturity",
          "action": {
            "type": "SCHEDULE",
            "hook": "scheduled",
            "tag": "MATURITY",
            "cadence": "AT_MATURITY"
          }
        }
      ],
      "prePosting": [
        {
          "ruleId": "posting.no-overdraft",
          "when": {
            "type": "postingComparison",
            "attribute": "PROJECTED_BALANCE",
            "operator": "LT",
            "threshold": "0.00"
          },
          "action": {
            "type": "REJECT",
            "reasonCode": "INSUFFICIENT_FUNDS"
          }
        },
        {
          "ruleId": "posting.early-withdrawal",
          "action": {
            "type": "EARLY_WITHDRAWAL_PENALTY"
          }
        }
      ],
      "scheduled": [
        {
          "ruleId": "scheduled.accrue",
          "trigger": "ACCRUAL",
          "action": {
            "type": "ACCRUE_INTEREST"
          }
        },
        {
          "ruleId": "scheduled.mature",
          "trigger": "MATURITY",
          "action": {
            "type": "MATURE"
          }
        }
      ]
    }
  },
  "clock": {
    "zone": "UTC"
  },
  "state": {
    "currency": "EUR",
    "balance": "10000.00",
    "accruedInterest": "0.000000",
    "openedOn": "2026-01-01"
  },
  "steps": [
