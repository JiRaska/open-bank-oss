{
  "name": "savings-fixed-reference",
  "description": "SAVINGS-FIXED on 500 EUR: an overdraft is rejected before it posts, 2.50 % ACT/365 accrues 0.034247 a day without the loyalty bonus (balance under 1000), the 2.00 fee is charged below the 5000 waiver threshold and waived above it after a 6000 deposit, month-end capitalisation posts 0.03.",
  "revision": {
    "irVersion": 1,
    "productCode": "SAVINGS-FIXED",
    "currency": "EUR",
    "interest": {
      "ruleId": "interest.base",
      "rateType": "FIXED",
      "rate": "0.0250",
      "dayCount": "ACT_365_FIXED",
      "accrualCadence": "DAILY",
      "capitalisationCadence": "MONTHLY",
      "accrualRounding": "INTEREST_ACCRUAL",
      "postingRounding": "LEDGER_POSTING",
      "bonus": {
        "ruleId": "interest.loyalty-bonus",
        "rate": "0.0100",
        "predicate": {
          "type": "and",
          "operands": [
            {
              "type": "noEvents",
              "kind": "WITHDRAWAL",
              "window": {
                "days": 30
              }
            },
            {
              "type": "balanceMin",
              "window": {
                "days": 30
              },
              "operator": "GTE",
              "amount": "1000.00"
            }
          ]
        }
      }
    },
    "fees": [
      {
        "ruleId": "fee.maintenance",
        "feeCode": "MAINT",
        "amount": "2.00",
        "cadence": "MONTHLY",
        "accountingClass": "FEE_INCOME",
        "waiver": {
          "type": "comparison",
          "attribute": "BALANCE",
          "operator": "GTE",
          "threshold": "5000.00",
          "currency": "EUR"
        }
      }
    ],
    "hooks": {
      "onOpen": [
        {
          "ruleId": "open.schedule-accrual",
          "action": {
            "type": "SCHEDULE",
            "hook": "scheduled",
            "tag": "ACCRUAL",
            "cadence": "DAILY"
          }
        },
        {
          "ruleId": "open.schedule-capitalisation",
          "action": {
            "type": "SCHEDULE",
            "hook": "scheduled",
            "tag": "CAPITALISATION",
            "cadence": "MONTHLY"
          }
        },
        {
          "ruleId": "open.schedule-fee",
          "action": {
            "type": "SCHEDULE",
            "hook": "scheduled",
            "tag": "FEE_MAINT",
            "cadence": "MONTHLY"
          }
        },
        {
          "ruleId": "open.welcome",
          "action": {
            "type": "NOTIFY",
            "templateId": "savings-welcome",
            "variables": {
              "productCode": "SAVINGS-FIXED"
            }
          }
        }
      ],
      "prePosting": [
        {
          "ruleId": "posting.no-overdraft",
          "when": {
            "type": "postingComparison",
            "attribute": "PROJECTED_BALANCE",
            "operator": "LT",
            "threshold": "0.00"
          },
          "action": {
            "type": "REJECT",
            "reasonCode": "INSUFFICIENT_FUNDS"
          }
        }
      ],
      "scheduled": [
        {
          "ruleId": "scheduled.accrue",
          "trigger": "ACCRUAL",
          "action": {
            "type": "ACCRUE_INTEREST"
          }
        },
        {
          "ruleId": "scheduled.capitalise",
          "trigger": "CAPITALISATION",
          "action": {
            "type": "CAPITALISE_INTEREST"
          }
        },
        {
          "ruleId": "scheduled.fee",
          "trigger": "FEE_MAINT",
          "action": {
            "type": "CHARGE_FEE",
            "feeRuleId": "fee.maintenance"
          }
        }
      ],
      "onParameterChange": [
        {
          "ruleId": "reprice.notify",
          "action": {
            "type": "NOTIFY",
            "templateId": "rate-changed",
            "variables": {
              "productCode": "SAVINGS-FIXED"
            }
          }
        }
      ]
    }
  },
  "clock": {
    "zone": "UTC"
  },
  "state": {
    "currency": "EUR",
    "balance": "500.00",
    "accruedInterest": "0.000000",
    "openedOn": "2026-01-01"
  },
