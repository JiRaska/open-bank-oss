{
  "consumer": {
    "name": "openbank-agent-service"
  },
  "interactions": [
    {
      "description": "GET the journal page behind the list_ledger_journals tool",
      "providerStates": [
        {
          "name": "ledger has journal entries for the reporting date"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/journals",
        "query": {
          "limit": [
            "20"
          ]
        }
      },
      "response": {
        "body": {
          "data": [
            {
              "entryDate": "string",
              "id": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
              "lines": [
                {
                  "amount": 100.0,
                  "currencyCode": "string",
                  "side": "string"
                }
              ],
              "status": "string",
              "synthetic": true
            }
          ],
          "pagination": {
            "hasNextPage": true,
            "limit": 20
          }
        },
        "generators": {
          "body": {
            "$.data[*].entryDate": {
              "size": 20,
              "type": "RandomString"
            },
            "$.data[*].id": {
              "type": "Uuid"
            },
            "$.data[*].lines[*].amount": {
              "digits": 10,
              "type": "RandomDecimal"
            },
            "$.data[*].lines[*].currencyCode": {
              "size": 20,
              "type": "RandomString"
            },
            "$.data[*].lines[*].side": {
              "size": 20,
              "type": "RandomString"
            },
            "$.data[*].status": {
              "size": 20,
              "type": "RandomString"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.data": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 0
                }
              ]
            },
            "$.data[*].entryDate": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.data[*].lines": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.data[*].lines[*].amount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.data[*].lines[*].currencyCode": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data[*].lines[*].side": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data[*].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data[*].synthetic": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.pagination.hasNextPage": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET the trial balance behind the get_trial_balance tool",
      "providerStates": [
        {
          "name": "ledger has journal entries for the reporting date"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/journals/trial-balance",
        "query": {
          "asOf": [
            "2024-01-31"
          ]
        }
      },
      "response": {
        "body": {
          "asOf": "2024-01-31",
          "balanced": true,
          "lines": [
            {
              "code": "string",
              "currency": "string",
              "totalCredit": 100.0,
              "totalDebit": 100.0
            }
          ],
          "scope": "string",
          "totalCredit": 100.0,
          "totalDebit": 100.0
        },
        "generators": {
          "body": {
            "$.lines[*].code": {
              "size": 20,
              "type": "RandomString"
            },
            "$.lines[*].currency": {
              "size": 20,
              "type": "RandomString"
            },
            "$.lines[*].totalCredit": {
              "digits": 10,
              "type": "RandomDecimal"
            },
            "$.lines[*].totalDebit": {
              "digits": 10,
              "type": "RandomDecimal"
            },
            "$.scope": {
              "size": 20,
              "type": "RandomString"
            },
            "$.totalCredit": {
              "digits": 10,
              "type": "RandomDecimal"
            },
            "$.totalDebit": {
              "digits": 10,
              "type": "RandomDecimal"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.balanced": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.lines": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 0
                }
              ]
            },
            "$.lines[*].code": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.lines[*].currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.lines[*].totalCredit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.lines[*].totalDebit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.scope": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.totalCredit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.totalDebit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET the trial balance with no asOf, behind the get_trial_balance tool",
      "providerStates": [
        {
          "name": "ledger has journal entries for the reporting date"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/journals/trial-balance"
      },
      "response": {
        "body": {
          "asOf": "string",
          "balanced": true,
          "lines": [
            {
              "code": "string",
              "net": 100.0
            }
          ],
          "scope": "string"
        },
        "generators": {
          "body": {
            "$.asOf": {
              "size": 20,
              "type": "RandomString"
            },
            "$.lines[*].code": {
              "size": 20,
              "type": "RandomString"
            },
            "$.lines[*].net": {
              "digits": 10,
              "type": "RandomDecimal"
            },
            "$.scope": {
              "size": 20,
              "type": "RandomString"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.asOf": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.balanced": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.lines": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 0
                }
              ]
            },
            "$.lines[*].code": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.lines[*].net": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.scope": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-ledger-service"
  }
}
