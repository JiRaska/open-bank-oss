{
  "consumer": {
    "name": "openbank-lending-service"
  },
  "interactions": [
    {
      "description": "GET whether the party granted the bank a CREDIT_OFFERS consent",
      "providerStates": [
        {
          "name": "an ACTIVE CREDIT_OFFERS consent covers the pact lending party"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/consents/party/c6c6c6c6-c6c6-4c6c-8c6c-c6c6c6c6c6c6/grantee/openbank/active",
        "query": {
          "scope": [
            "CREDIT_OFFERS"
          ]
        }
      },
      "response": {
        "body": {
          "granted": true
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-consent-service"
  }
}
