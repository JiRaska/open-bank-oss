{
  "consumer": {
    "name": "openbank-account-service"
  },
  "interactions": [
    {
      "description": "POST an account-opening screen with no M2M identity is refused",
      "providerStates": [
        {
          "name": "no valid M2M identity is presented"
        }
      ],
      "request": {
        "body": {
          "aliases": [

          ],
          "entityType": "INDIVIDUAL",
          "idempotencyKey": "account-open:33333333-3333-4333-8333-333333333333:pact-clear",
          "name": "Zdenka Bezprijmeni"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/sanctions/screen"
      },
      "response": {
        "status": 401
      }
    },
    {
      "description": "POST an account-opening screen for a name on no sanctions or PEP list",
      "providerStates": [
        {
          "name": "the sanctions lists are seeded and carry no entry for the screened name"
        }
      ],
      "request": {
        "body": {
          "aliases": [

          ],
          "entityType": "INDIVIDUAL",
          "idempotencyKey": "account-open:33333333-3333-4333-8333-333333333333:pact-clear",
          "name": "Zdenka Bezprijmeni"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/sanctions/screen"
      },
      "response": {
        "body": {
          "matches": [

          ],
          "overallScore": 0.0,
          "status": "CLEAR"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.overallScore": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 201
      }
    },
    {
      "description": "POST an account-opening screen for a name on the seeded sanctions lists",
      "providerStates": [
        {
          "name": "the sanctions lists are seeded with the boot-time OFAC/EU/UN/PEP entries"
        }
      ],
      "request": {
        "body": {
          "aliases": [

          ],
          "entityType": "INDIVIDUAL",
          "idempotencyKey": "account-open:44444444-4444-4444-8444-444444444444:pact-hit",
          "name": "Vladimir Putin"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/sanctions/screen"
      },
      "response": {
        "body": {
          "matches": [
            {
              "matchScore": 1.0,
              "matchedName": "Vladimir Putin"
            }
          ],
          "overallScore": 1.0,
          "status": "HIT"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.matches": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.matches[*].matchScore": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.matches[*].matchedName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.overallScore": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 201
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-sanctions-service"
  }
}
