{
  "consumer": {
    "name": "openbank-billing-service"
  },
  "interactions": [
    {
      "description": "GET the account a fee is priced against",
      "providerStates": [
        {
          "name": "an account owned by a known party exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/accounts/11111111-2222-4333-8444-555555555555"
      },
      "response": {
        "body": {
          "currencyCode": "CZK",
          "id": "11111111-2222-4333-8444-555555555555",
          "partyId": "66666666-7777-4888-8999-aaaaaaaaaaaa",
          "productId": "99999999-8888-4777-8666-555555555555",
          "status": "ACTIVE"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET the first page of ACTIVE accounts for the billing sweep",
      "providerStates": [
        {
          "name": "an account owned by a known party exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/accounts/active",
        "query": {
          "limit": [
            "100"
          ]
        }
      },
      "response": {
        "body": {
          "data": [
            {
              "currencyCode": "CZK",
              "id": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
              "productId": "e2490de5-5bd3-43d5-b7c4-526e33f71304"
            }
          ],
          "pagination": {
            "hasNextPage": false
          }
        },
        "generators": {
          "body": {
            "$.data[*].id": {
              "type": "Uuid"
            },
            "$.data[*].productId": {
              "type": "Uuid"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.data": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.data[*].currencyCode": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.data[*].productId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.pagination.hasNextPage": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET an account for fee pricing with no M2M identity is refused",
      "providerStates": [
        {
          "name": "no valid M2M identity is presented"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/accounts/11111111-2222-4333-8444-555555555555"
      },
      "response": {
        "status": 401
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-account-service"
  }
}
