{
  "consumer": {
    "name": "openbank-agent-service"
  },
  "interactions": [
    {
      "description": "GET the account the agent's get_account tool reads for an operator",
      "providerStates": [
        {
          "name": "an account owned by a known party exists"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v1/accounts/11111111-2222-4333-8444-555555555555"
      },
      "response": {
        "body": {
          "accountNumber": "CZ6508000000192000145399",
          "accountType": "CURRENT",
          "currencyCode": "CZK",
          "id": "11111111-2222-4333-8444-555555555555",
          "partyId": "66666666-7777-4888-8999-aaaaaaaaaaaa",
          "productId": "99999999-8888-4777-8666-555555555555",
          "status": "ACTIVE"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.accountNumber": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.accountType": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.currencyCode": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.partyId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.productId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET an account id the bank does not hold",
      "providerStates": [
        {
          "name": "no account exists for the id"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v1/accounts/00000000-0000-4000-8000-000000000099"
      },
      "response": {
        "status": 404
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-account-service"
  }
}
