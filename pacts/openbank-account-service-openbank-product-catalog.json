{
  "consumer": {
    "name": "openbank-account-service"
  },
  "interactions": [
    {
      "description": "GET product by id for an existing product",
      "providerStates": [
        {
          "name": "a product with card configuration exists for code CURRENT_PERSONAL"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v1/products/3f20a53e-5ea4-307a-8a0f-9605728381ba"
      },
      "response": {
        "body": {
          "code": "CURRENT_PERSONAL",
          "currency": "EUR",
          "id": "3f20a53e-5ea4-307a-8a0f-9605728381ba",
          "status": "ACTIVE"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.code": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET the published revision of a v1 product to pin at account opening",
      "providerStates": [
        {
          "name": "a published v1-projected deposit revision exists for billing"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v2/legacy-products/3f20a53e-5ea4-307a-8a0f-9605728381ba/published-revision",
        "query": {
          "effectiveAt": [
            "2099-01-01T00:00:00Z"
          ]
        }
      },
      "response": {
        "body": {
          "id": "0191c0de-0000-7000-8000-00000000b111",
          "number": 1,
          "offeringId": "0191c0de-0000-7000-8000-00000000a111",
          "state": "PUBLISHED"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.number": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.offeringId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET product by an unknown id",
      "providerStates": [
        {
          "name": "no product exists with id 00000000-0000-0000-0000-000000000fff"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v1/products/00000000-0000-0000-0000-000000000fff"
      },
      "response": {
        "body": {
          "error": "Product 00000000-0000-0000-0000-000000000fff not found"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 404
      }
    },
    {
      "description": "GET the published revision of an unknown v1 product to pin at account opening",
      "providerStates": [
        {
          "name": "no product exists with id 00000000-0000-0000-0000-000000000fff"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v2/legacy-products/00000000-0000-0000-0000-000000000fff/published-revision",
        "query": {
          "effectiveAt": [
            "2099-01-01T00:00:00Z"
          ]
        }
      },
      "response": {
        "status": 404
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-product-catalog"
  }
}
