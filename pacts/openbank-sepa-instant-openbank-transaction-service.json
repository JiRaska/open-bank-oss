{
  "consumer": {
    "name": "openbank-sepa-instant"
  },
  "interactions": [
    {
      "description": "POST initiate SCT Inst settlement transaction",
      "providerStates": [
        {
          "name": "a valid source account exists"
        }
      ],
      "request": {
        "body": {
          "amount": 500.00,
          "currencyCode": "EUR",
          "description": "SCT Inst settlement pact-e2e-001",
          "idempotencyKey": "sct-inst-settlement-pact-001",
          "instructionType": "ONE_OFF",
          "rail": "SEPA_INST",
          "sourceAccountId": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
          "type": "DEBIT",
          "valueDate": "2026-01-20"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/transactions"
      },
      "response": {
        "body": {
          "amount": 500.0,
          "currencyCode": "EUR",
          "id": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
          "instructionType": "ONE_OFF",
          "rail": "SEPA_INST",
          "sourceAccountId": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
          "status": "COMPLETED",
          "type": "DEBIT"
        },
        "generators": {
          "body": {
            "$.id": {
              "type": "Uuid"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.amount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          }
        },
        "status": 201
      }
    },
    {
      "description": "POST initiate SCT Inst settlement with no credentials",
      "providerStates": [
        {
          "name": "no valid M2M identity is presented"
        }
      ],
      "request": {
        "body": {
          "amount": 500.00,
          "currencyCode": "EUR",
          "description": "SCT Inst settlement pact-e2e-001",
          "idempotencyKey": "sct-inst-settlement-pact-001",
          "instructionType": "ONE_OFF",
          "rail": "SEPA_INST",
          "sourceAccountId": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
          "type": "DEBIT",
          "valueDate": "2026-01-20"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/transactions"
      },
      "response": {
        "status": 401
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-transaction-service"
  }
}
