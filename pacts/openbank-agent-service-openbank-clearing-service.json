      "providerStates": [
        {
          "name": "a clearing batch with one item exists for the pact agent"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/clearing/batches",
        "query": {
          "page": [
            "0"
          ],
          "size": [
            "20"
          ]
        }
      },
      "response": {
        "body": [
          {
            "batchReference": "string",
            "currency": "string",
            "id": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
            "itemCount": 100,
            "rail": "string",
            "status": "string",
            "totalDebit": 100.0
          }
        ],
        "generators": {
          "body": {
            "$[*].batchReference": {
              "size": 20,
              "type": "RandomString"
            },
            "$[*].currency": {
              "size": 20,
              "type": "RandomString"
            },
            "$[*].id": {
              "type": "Uuid"
            },
            "$[*].itemCount": {
              "max": 2147483647,
              "min": 0,
              "type": "RandomInt"
            },
            "$[*].rail": {
              "size": 20,
              "type": "RandomString"
            },
            "$[*].status": {
              "size": 20,
              "type": "RandomString"
            },
            "$[*].totalDebit": {
              "digits": 10,
              "type": "RandomDecimal"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].batchReference": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$[*].itemCount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$[*].rail": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].totalDebit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
