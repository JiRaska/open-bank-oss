{
  "consumer": {
    "name": "openbank-agent-service"
  },
  "interactions": [
    {
      "description": "GET the batch behind the clearing_get_batch tool",
      "providerStates": [
        {
          "name": "a clearing batch with one item exists for the pact agent"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/clearing/batches/7a7a7a7a-7a7a-4a7a-8a7a-7a7a7a7a7a7a"
      },
      "response": {
        "body": {
          "batchReference": "PACT-AGENT-BATCH-001",
          "currency": "EUR",
          "id": "7a7a7a7a-7a7a-4a7a-8a7a-7a7a7a7a7a7a",
          "itemCount": 1,
          "rail": "SEPA_SCT",
          "status": "SETTLED"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "GET the batch items behind the clearing_get_batch_items tool",
      "providerStates": [
        {
          "name": "a clearing batch with one item exists for the pact agent"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/clearing/batches/7a7a7a7a-7a7a-4a7a-8a7a-7a7a7a7a7a7a/items"
      },
      "response": {
        "body": [
          {
            "amount": 100.0,
            "batchId": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
            "currency": "string",
            "id": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
            "paymentReference": "string",
            "status": "string"
          }
        ],
        "generators": {
          "body": {
            "$[*].amount": {
              "digits": 10,
              "type": "RandomDecimal"
            },
            "$[*].batchId": {
              "type": "Uuid"
            },
            "$[*].currency": {
              "size": 20,
              "type": "RandomString"
            },
            "$[*].id": {
              "type": "Uuid"
            },
            "$[*].paymentReference": {
              "size": 20,
              "type": "RandomString"
            },
            "$[*].status": {
              "size": 20,
              "type": "RandomString"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].amount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$[*].batchId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$[*].currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$[*].paymentReference": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
