{
  "consumer": {
    "name": "openbank-domestic-payment"
  },
  "interactions": [
    {
      "description": "GET the debtor account with its standing before a domestic payment is admitted",
      "providerStates": [
        {
          "name": "an account owned by a known party exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/accounts/11111111-2222-4333-8444-555555555555"
      },
      "response": {
        "body": {
          "id": "11111111-2222-4333-8444-555555555555",
          "partyId": "66666666-7777-4888-8999-aaaaaaaaaaaa",
          "standing": {
            "mayDebit": true
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.partyId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET the standing of a debtor account that does not exist",
      "providerStates": [
        {
          "name": "no account exists for the requested account"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/accounts/7d7d7d7d-0000-4000-8000-7d7d7d7d7d7d"
      },
      "response": {
        "status": 404
      }
    },
    {
      "description": "GET the debtor account with its standing with no M2M identity is refused",
      "providerStates": [
        {
          "name": "no valid M2M identity is presented"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/accounts/11111111-2222-4333-8444-555555555555"
      },
      "response": {
        "status": 401
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-account-service"
  }
}
