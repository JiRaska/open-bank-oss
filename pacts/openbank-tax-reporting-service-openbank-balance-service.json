{
  "consumer": {
    "name": "openbank-tax-reporting-service"
  },
  "interactions": [
    {
      "description": "GET the CZK balance as of the period end for the CRS FATCA line",
      "providerStates": [
        {
          "name": "a CZK balance exists for the balance account"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/balances/d5d5d5d5-d5d5-d5d5-d5d5-d5d5d5d5d5d5/CZK",
        "query": {
          "asOf": [
            "2000-01-31"
          ]
        }
      },
      "response": {
        "body": {
          "bookedAmount": 5000.0
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.bookedAmount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET the balance with no M2M identity is refused",
      "providerStates": [
        {
          "name": "no valid M2M identity is presented"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/balances/d5d5d5d5-d5d5-d5d5-d5d5-d5d5d5d5d5d5/CZK",
        "query": {
          "asOf": [
            "2000-01-31"
          ]
        }
      },
      "response": {
        "status": 401
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-balance-service"
  }
}
