{
  "consumer": {
    "name": "openbank-pension-service"
  },
  "interactions": [
    {
      "description": "POST render with no M2M identity is refused",
      "providerStates": [
        {
          "name": "no valid M2M identity is presented"
        }
      ],
      "request": {
        "body": {
          "caseRef": "a0000000-0000-4000-8000-000000000001",
          "contentType": "application/pdf",
          "data": {
            "applicationId": "a0000000-0000-4000-8000-000000000001",
            "documentType": "PRE_CONTRACTUAL_INFORMATION",
            "legalReviewRequired": true,
            "productLine": "DPS",
            "strategyCode": "BALANCED"
          },
          "partyRef": "b0000000-0000-4000-8000-000000000001",
          "productRef": "pension-dps",
          "retainUntil": null,
          "templateCode": "pension-dps-key-information-cs"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/documents/render"
      },
      "response": {
        "status": 401
      }
    },
    {
      "description": "POST render the pension key-information document for a strategy choice",
      "providerStates": [
        {
          "name": "the canonical document templates are seeded and published"
        }
      ],
      "request": {
        "body": {
          "caseRef": "a0000000-0000-4000-8000-000000000001",
          "contentType": "application/pdf",
          "data": {
            "applicationId": "a0000000-0000-4000-8000-000000000001",
            "documentType": "PRE_CONTRACTUAL_INFORMATION",
            "legalReviewRequired": true,
            "productLine": "DPS",
            "strategyCode": "BALANCED"
          },
          "partyRef": "b0000000-0000-4000-8000-000000000001",
          "productRef": "pension-dps",
          "retainUntil": null,
          "templateCode": "pension-dps-key-information-cs"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/documents/render"
      },
      "response": {
        "body": {
          "id": "d0c0d0c0-0000-4000-8000-0000000000aa",
          "sha256": "abababababababababababababababababababababababababababababababab",
          "templateCode": "pension-dps-key-information-cs"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.sha256": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[0-9a-f]{64}$"
                }
              ]
            },
            "$.templateCode": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 201
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-document-service"
  }
}
