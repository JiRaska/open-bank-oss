{
  "consumer": {
    "name": "openbank-sdd-service"
  },
  "interactions": [
    {
      "description": "POST an authorised SDD collection as a SEPA_CT direct-debit debit",
      "providerStates": [
        {
          "name": "a valid source account exists"
        }
      ],
      "request": {
        "body": {
          "amount": 89.90,
          "currencyCode": "EUR",
          "description": "SEPA Direct Debit DE98ZZZ09999999999 / UMR-PACT-0001",
          "idempotencyKey": "so-sdd-3b9d1c44-1111-4222-8333-444444444444-UMR-PACT-0001-2026-02-20",
          "instructionType": "DIRECT_DEBIT",
          "rail": "SEPA_CT",
          "sourceAccountId": "dddddddd-1111-4222-8333-444444444444",
          "type": "DEBIT",
          "valueDate": "2026-02-20"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/transactions"
      },
      "response": {
        "body": {
          "id": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
          "instructionType": "DIRECT_DEBIT",
          "rail": "SEPA_CT",
          "status": "COMPLETED"
        },
        "generators": {
          "body": {
            "$.id": {
              "type": "Uuid"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          }
        },
        "status": 201
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-transaction-service"
  }
}
