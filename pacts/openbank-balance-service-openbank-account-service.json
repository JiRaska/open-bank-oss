{
  "consumer": {
    "name": "openbank-balance-service"
  },
  "messages": [
    {
      "contents": {
        "aggregateId": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
        "currency": "CZK",
        "eventType": "AccountCreated"
      },
      "description": "an AccountCreated event",
      "generators": {
        "body": {
          "$.aggregateId": {
            "type": "Uuid"
          }
        }
      },
      "matchingRules": {
        "body": {
          "$.aggregateId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            ]
          },
          "$.currency": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        }
      },
      "metaData": {
        "contentType": "application/json"
      },
      "providerStates": [
        {
          "name": "an account has been created"
        }
      ]
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-account-service"
  }
}
