                  "match": "type"
                }
              ]
            },
            "$.sourceContentHashes[4]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.sourceContentHashes[5]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
