{
  "consumer": {
    "name": "openbank-lending-service"
  },
  "interactions": [
    {
      "description": "POST lending guarantor proof for a verified customer",
      "providerStates": [
        {
          "name": "a verified lending guarantor exists"
        }
      ],
      "request": {
        "body": {
          "partyId": "f0c8d9e0-0000-4000-8000-000000000001"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/parties/lending-guarantor-identity/verify"
      },
      "response": {
        "body": {
          "verified": true
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "POST lending guarantor proof with an unauthorized caller",
      "providerStates": [
        {
          "name": "a verified lending guarantor exists"
        }
      ],
      "request": {
        "body": {
          "partyId": "f0c8d9e0-0000-4000-8000-000000000001"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/parties/lending-guarantor-identity/verify"
      },
      "response": {
        "status": 403
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-party-service"
  }
}
