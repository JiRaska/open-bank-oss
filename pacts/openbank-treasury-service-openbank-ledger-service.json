{
  "consumer": {
    "name": "openbank-treasury-service"
  },
  "interactions": [
    {
      "description": "GET the balance of a GL account the ledger does not hold",
      "providerStates": [
        {
          "name": "ledger does not hold GL account 9999"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v1/journals/accounts/9999/balance",
        "query": {
          "asOf": [
            "2026-03-15"
          ],
          "currency": [
            "EUR"
          ]
        }
      },
      "response": {
        "body": {
          "error": "GL account 9999 not found"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 404
      }
    },
    {
      "description": "GET the EUR nostro GL balance in EUR as of the statement date",
      "providerStates": [
        {
          "name": "ledger has a EUR journal line on 1002 for the statement date"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v1/journals/accounts/1002/balance",
        "query": {
          "asOf": [
            "2026-03-15"
          ],
          "currency": [
            "EUR"
          ]
        }
      },
      "response": {
        "body": {
          "asOf": "2026-03-15",
          "code": "1002",
          "credit": 0.0,
          "currency": "EUR",
          "debit": 10000.0,
          "net": 10000.0,
          "scope": "REAL_ONLY"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.credit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.debit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.net": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.scope": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET journal entries for the CZK nostro GL window on the statement date",
      "providerStates": [
        {
          "name": "ledger has a nostro journal line on 1001 for the statement date"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v1/journals",
        "query": {
          "fromDate": [
            "2026-03-15"
          ],
          "limit": [
            "200"
          ],
          "toDate": [
            "2026-03-15"
          ]
        }
      },
      "response": {
        "body": {
          "data": [
            {
              "description": "MM placement settlement",
              "entryDate": "2026-03-15",
              "id": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
              "lines": [
                {
                  "amount": 250000.0,
                  "currencyCode": "CZK",
                  "glAccountId": "a0000000-0000-0000-0000-000000001001",
                  "id": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
                  "side": "CREDIT"
                }
              ],
              "status": "POSTED",
              "synthetic": false,
              "transactionId": "e2490de5-5bd3-43d5-b7c4-526e33f71304"
            }
          ],
          "pagination": {
            "hasNextPage": false,
            "limit": 200
          }
        },
        "generators": {
          "body": {
            "$.data[*].id": {
              "type": "Uuid"
            },
            "$.data[*].lines[*].id": {
              "type": "Uuid"
            },
            "$.data[*].transactionId": {
              "type": "Uuid"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.data": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.data[*].description": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.data[*].lines": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.data[*].lines[*].amount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.data[*].lines[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.data[*].synthetic": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.data[*].transactionId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.pagination.hasNextPage": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.pagination.limit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
