{
  "consumer": {
    "name": "openbank-agent-service"
  },
  "interactions": [
    {
      "description": "GET the active holds behind the get_balance_holds tool",
      "providerStates": [
        {
          "name": "a CZK hold exists for the holds account"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/balances/c3c3c3c3-c3c3-c3c3-c3c3-c3c3c3c3c3c3/holds"
      },
      "response": {
        "body": {
          "holds": [
            {
              "accountId": "c3c3c3c3-c3c3-c3c3-c3c3-c3c3c3c3c3c3",
              "amount": 100.0,
              "currency": "CZK",
              "id": "b2b2b2b2-b2b2-b2b2-b2b2-b2b2b2b2b2b2",
              "reason": "payment-cover",
              "referenceId": "pact-tx-00000001"
            }
          ]
        },
        "generators": {
          "body": {
            "$.holds[0].amount": {
              "digits": 10,
              "type": "RandomDecimal"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.holds[0].accountId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.holds[0].amount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.holds[0].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET the holds the agent's get_balance_holds tool returns verbatim",
      "providerStates": [
        {
          "name": "an active CZK hold exists for the agent holds account"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v1/balances/d2d2d2d2-d2d2-42d2-82d2-d2d2d2d2d2d2/holds"
      },
      "response": {
        "body": {
          "holds": [
            {
              "accountId": "d2d2d2d2-d2d2-42d2-82d2-d2d2d2d2d2d2",
              "amount": 100.0,
              "currency": "CZK",
              "id": "e2e2e2e2-e2e2-42e2-82e2-e2e2e2e2e2e2",
              "reason": "payment-cover",
              "referenceId": "pact-agent-hold-0001"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.holds": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.holds[*].accountId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.holds[*].amount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.holds[*].currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.holds[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.holds[*].reason": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.holds[*].referenceId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET the balances the agent's get_account_balance tool returns verbatim",
      "providerStates": [
        {
          "name": "balance-service is reachable and holds no balances for the pact account"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v1/balances/d1d1d1d1-e2e2-4f4f-8a8a-b9b9b9b9b9b9"
      },
      "response": {
        "body": {
          "balances": [
            {
              "available": 1000.0,
              "currency": "CZK"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.balances": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 0
                }
              ]
            },
            "$.balances[*].available": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.balances[*].currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET the holds of an account that has none, via the get_balance_holds tool",
      "providerStates": [
        {
          "name": "balance-service is reachable and holds no balances for the pact account"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/balances/e4e4e4e4-e4e4-4e4e-8e4e-e4e4e4e4e4e4/holds"
      },
      "response": {
        "body": {
          "holds": [

          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "GET active holds without an authenticated identity",
      "providerStates": [
        {
          "name": "no valid M2M identity is presented"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/balances/c3c3c3c3-c3c3-c3c3-c3c3-c3c3c3c3c3c3/holds"
      },
      "response": {
        "status": 401
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-balance-service"
  }
}
