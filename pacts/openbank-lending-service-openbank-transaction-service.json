{
  "consumer": {
    "name": "openbank-lending-service"
  },
  "interactions": [
    {
      "description": "POST the loan disbursement credit into the borrower's account",
      "providerStates": [
        {
          "name": "a valid borrower account exists"
        }
      ],
      "request": {
        "body": {
          "amount": 250000.00,
          "currencyCode": "CZK",
          "description": "Loan disbursement",
          "idempotencyKey": "loan-disbursement-pact-001",
          "sourceAccountId": null,
          "targetAccountId": "44444444-5555-4666-8777-888888888888",
          "type": "CREDIT",
          "valueDate": "2026-01-20"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/transactions"
      },
      "response": {
        "body": {
          "id": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
          "status": "COMPLETED"
        },
        "generators": {
          "body": {
            "$.id": {
              "type": "Uuid"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          }
        },
        "status": 201
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-transaction-service"
  }
}
