{
  "consumer": {
    "name": "openbank-settlement-service"
  },
  "interactions": [
    {
      "description": "POST a settlement debit leg with no M2M identity is refused",
      "providerStates": [
        {
          "name": "no valid M2M identity is presented"
        }
      ],
      "request": {
        "body": {
          "amount": 250.0,
          "currency": "CZK",
          "description": "Settlement 5e77e000-0000-4000-8000-000000000001 debit leg",
          "referenceId": "settlement-debit-5e77e000-0000-4000-8000-000000000001"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/balances/d5d5d5d5-d5d5-d5d5-d5d5-d5d5d5d5d5d5/debit"
      },
      "response": {
        "status": 401
      }
    },
    {
      "description": "POST the payee credit leg of a settlement",
      "providerStates": [
        {
          "name": "a CZK balance exists for the balance account"
        }
      ],
      "request": {
        "body": {
          "amount": 250.0,
          "currency": "CZK",
          "description": "Settlement 5e77e000-0000-4000-8000-000000000001 credit leg",
          "referenceId": "settlement-credit-5e77e000-0000-4000-8000-000000000001"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/balances/d5d5d5d5-d5d5-d5d5-d5d5-d5d5d5d5d5d5/credit"
      },
      "response": {
        "body": {
          "accountId": "d5d5d5d5-d5d5-d5d5-d5d5-d5d5d5d5d5d5",
          "currency": "CZK"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "POST the payer debit leg of a settlement",
      "providerStates": [
        {
          "name": "a CZK balance exists for the balance account"
        }
      ],
      "request": {
        "body": {
          "amount": 250.0,
          "currency": "CZK",
          "description": "Settlement 5e77e000-0000-4000-8000-000000000001 debit leg",
          "referenceId": "settlement-debit-5e77e000-0000-4000-8000-000000000001"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/balances/d5d5d5d5-d5d5-d5d5-d5d5-d5d5d5d5d5d5/debit"
      },
      "response": {
        "body": {
          "accountId": "d5d5d5d5-d5d5-d5d5-d5d5-d5d5d5d5d5d5",
          "currency": "CZK"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "settlement reserves payer cover until ledger projection consumes it",
      "providerStates": [
        {
          "name": "a CZK balance exists for the holds account with sufficient funds"
        }
      ],
      "request": {
        "body": {
          "amount": 125.5,
          "currency": "CZK",
          "reason": "Settlement cover",
          "referenceId": "55555555-5555-5555-5555-555555555520",
          "ttlSeconds": null
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/balances/a1a1a1a1-a1a1-a1a1-a1a1-a1a1a1a1a1a1/holds"
      },
      "response": {
        "body": {
          "accountId": "a1a1a1a1-a1a1-a1a1-a1a1-a1a1a1a1a1a1",
          "amount": 125.5,
          "currency": "CZK",
          "expiresAt": null,
          "id": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
          "referenceId": "55555555-5555-5555-5555-555555555520",
          "releasedAt": null
        },
        "generators": {
          "body": {
            "$.id": {
              "type": "Uuid"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          }
        },
        "status": 201
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-balance-service"
  }
}
