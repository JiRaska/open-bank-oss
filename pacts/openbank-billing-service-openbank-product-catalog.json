{
  "consumer": {
    "name": "openbank-billing-service"
  },
  "interactions": [
    {
      "description": "GET an immutable deposit revision by its id",
      "providerStates": [
        {
          "name": "a published v1-projected deposit revision exists for billing"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v2/revisions/0191c0de-0000-7000-8000-00000000b111"
      },
      "response": {
        "body": {
          "content": {
            "attributes": {
              "legacyDocument": "{\"fees\":[{\"id\":\"f1\",\"name\":\"Monthly maintenance\",\"type\":\"MONTHLY\",\"amount\":150.0,\"currency\":\"CZK\",\"waivable\":false}]}",
              "productType": "CURRENT"
            },
            "prices": [
              {
                "cadence": "MONTHLY",
                "code": "FEE_F1_3F524CDC07A11D7C6220",
                "currency": "CZK",
                "kind": "AMOUNT",
                "unit": "monthly",
                "value": "150.00"
              }
            ]
          },
          "id": "0191c0de-0000-7000-8000-00000000b111",
          "state": "PUBLISHED"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.content.attributes.legacyDocument": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.content.prices": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.content.prices[*].cadence": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.content.prices[*].unit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET the published revision of a v1 deposit product by its product id",
      "providerStates": [
        {
          "name": "a published v1-projected deposit revision exists for billing"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v2/legacy-products/3f20a53e-5ea4-307a-8a0f-9605728381ba/published-revision"
      },
      "response": {
        "body": {
          "id": "0191c0de-0000-7000-8000-00000000b111",
          "state": "PUBLISHED"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "GET the published revision of a v1 product the catalog does not know",
      "providerStates": [
        {
          "name": "no product exists with id 00000000-0000-0000-0000-000000000fff"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v2/legacy-products/00000000-0000-0000-0000-000000000fff/published-revision"
      },
      "response": {
        "status": 404
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-product-catalog"
  }
}
