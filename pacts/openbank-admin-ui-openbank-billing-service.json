{
  "consumer": {
    "name": "openbank-admin-ui"
  },
  "interactions": [
    {
      "description": "list pending billing approvals for the Admin UI inbox",
      "providerStates": [
        {
          "name": "a pending billing approval exists"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer pact-operator-token"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer [A-Za-z0-9._-]+$"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/v1/fees/approvals",
        "query": {
          "limit": [
            "50"
          ]
        }
      },
      "response": {
        "body": [
          {
            "action": "billing.post",
            "createdAt": "2026-08-31T11:00:42Z",
            "id": "billing-approval-4",
            "makerId": "maker.billing",
            "resourceId": "fee-4"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.3"
    },
    "pactRust": {
      "ffi": "0.5.6",
      "models": "1.3.14"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-billing-service"
  }
}