{
  "consumer": {
    "name": "openbank-balance-service"
  },
  "interactions": [
    {
      "description": "GET trial-balance as-of a specific date",
      "providerStates": [
        {
          "name": "ledger has journal entries for the reporting date"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v1/journals/trial-balance",
        "query": {
          "asOf": [
            "2024-01-31"
          ]
        }
      },
      "response": {
        "body": {
          "asOf": "2024-01-31",
          "balanced": true,
          "lines": [
            {
              "code": "1100-DEPOSITS-CZK",
              "currency": "CZK",
              "totalCredit": 100000.0,
              "totalDebit": 100000.0
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.balanced": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.lines": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 0
                }
              ]
            },
            "$.lines[*].code": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.lines[*].currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.lines[*].totalCredit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.lines[*].totalDebit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET trial-balance returns balanced empty ledger",
      "providerStates": [
        {
          "name": "ledger has no journal entries"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/api/v1/journals/trial-balance",
        "query": {
          "asOf": [
            "2000-01-01"
          ]
        }
      },
      "response": {
        "body": {
          "asOf": "2000-01-01",
          "balanced": true,
          "lines": [

          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.balanced": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-ledger-service"
  }
}
