    {
      "description": "GET the unit holdings of a pension contract whose fund has no published NAV yet",
      "providerStates": [
        {
          "name": "a pension contract holds units in a fund with no published NAV"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/contracts/7a1e0000-0000-4000-8000-0000000000c2/holdings"
      },
      "response": {
        "body": {
          "contractId": "7a1e0000-0000-4000-8000-0000000000c2",
          "holdings": [
            {
              "currency": "CZK",
              "fundId": "7a1e0000-0000-4000-8000-0000000000f2",
              "navDate": null,
              "navPerUnit": null,
              "units": 40.000000,
              "value": null
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.contractId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.holdings": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.holdings[*].fundId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.holdings[*].units": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
