{
  "consumer": {
    "name": "openbank-finrep-service"
  },
  "interactions": [
    {
      "description": "GET the Pillar 1 credit-risk capital of a TIED_OUT run",
      "providerStates": [
        {
          "name": "a TIED_OUT risk snapshot exists at the report date"
        }
      ],
      "request": {
        "generators": {
          "path": {
            "dataType": "STRING",
            "expression": "/api/v1/risk/snapshots/${runId}/capital",
            "type": "ProviderState"
          }
        },
        "method": "GET",
        "path": "/api/v1/risk/snapshots/0190a4c0-0000-7000-8000-00000000c020/capital"
      },
      "response": {
        "body": {
          "asOf": "2026-06-30",
          "currencies": [
            {
              "classes": [
                {
                  "ead": 1500.0,
                  "exposureClass": "cash",
                  "rwa": 0.0
                }
              ],
              "currency": "CZK",
              "totalRwa": 0.0
            }
          ],
          "parameterSetId": "bcbs-d424-sa",
          "parameterSetVersion": "1",
          "runId": "0190a4c0-0000-7000-8000-00000000c020",
          "total": {
            "classes": [
              {
                "ead": 1500.0,
                "exposureClass": "cash",
                "rwa": 0.0
              }
            ],
            "currency": "CZK",
            "totalRwa": 0.0
          },
          "unclassified": [
            {
              "glAccountCode": "9999"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        },
        "matchingRules": {
          "body": {
            "$.currencies": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.currencies[*].classes": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.currencies[*].classes[*].ead": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.currencies[*].classes[*].exposureClass": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.currencies[*].classes[*].rwa": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.currencies[*].currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.currencies[*].totalRwa": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.parameterSetId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.parameterSetVersion": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.runId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.total.classes": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.total.classes[*].ead": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.total.classes[*].exposureClass": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.total.classes[*].rwa": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.total.currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.total.totalRwa": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.unclassified": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 0
                }
              ]
            },
            "$.unclassified[*].glAccountCode": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json(;\\s?charset=[\\w\\-]+)?"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "GET the most recent risk snapshot runs for a COREP report date",
      "providerStates": [
        {
          "name": "a TIED_OUT risk snapshot exists at the report date"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/risk/snapshots",
        "query": {
          "limit": [
            "100"
          ]
        }
      },
      "response": {
        "body": {
          "runs": [
            {
              "asOf": "2026-06-30",
              "id": "0190a4c0-0000-7000-8000-00000000c020",
              "recordedAt": "2026-07-01T06:00:00Z",
              "status": "TIED_OUT"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json; charset=UTF-8"
        },
        "matchingRules": {
          "body": {
            "$.runs": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.runs[*].asOf": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.runs[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.runs[*].recordedAt": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.runs[*].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json(;\\s?charset=[\\w\\-]+)?"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-risk-engine"
  }
}
