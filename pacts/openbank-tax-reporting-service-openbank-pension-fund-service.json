            "totalEquity": 1000,
            "totalLiabilities": 0
          },
          "closingValuationDate": "2026-09-30",
          "currency": "CZK",
          "entitlements": {
            "closing": 1000,
            "decrease": 0,
            "increase": 1000,
            "opening": 0
