                {
                  "match": "decimal"
                }
              ]
            },
            "$.balances[0].availableAmount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.balances[0].bookedAmount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.balances[0].currency": {
