          "lines": [
            {
              "amount": 150.00,
              "baseAmount": 150.00,
              "baseCurrencyCode": "CZK",
              "currencyCode": "CZK",
              "glAccountId": "a0000000-0000-0000-0000-000000000002",
              "side": "DEBIT",
              "subAccountId": "99999999-9999-9999-9999-999999999999"
            },
            {
              "amount": 150.00,
              "baseAmount": 150.00,
              "baseCurrencyCode": "CZK",
              "currencyCode": "CZK",
              "glAccountId": "a0000000-0000-0000-0000-000000004003",
              "side": "CREDIT",
              "subAccountId": null
            }
          ],
          "transactionId": "61032cf1-5aff-3102-93ca-fd8f781d0cac",
          "valueDate": "2026-07-01"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/api/v1/journals"
