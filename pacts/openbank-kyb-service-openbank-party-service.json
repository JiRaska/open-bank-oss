{
  "consumer": {
    "name": "openbank-kyb-service"
  },
  "interactions": [
    {
      "description": "PUT an attested joint statutory rule for the verified roster",
      "providerStates": [
        {
          "name": "a company has two active linked KYB statutory mandates"
        }
      ],
      "request": {
        "body": {
          "attestationId": "d51d07bf-1cd4-4098-85f1-628a0d3da622",
          "attestedAt": "2026-08-01T00:00:00Z",
          "caseId": "1ffb1a70-12e4-4409-8333-bb48acbd6e48",
          "mode": "JOINT_ALL",
          "representatives": [
            {
              "mandateEvidenceHash": "6075a77a3fec5f0f0d5a17de07b7098d8476485eafd279b588e08edb8f9a4d6e",
              "officeSlots": [
                0
              ],
              "partyId": "6eb9e3d4-94d7-4224-9ce3-f6388d992a94"
            },
            {
              "mandateEvidenceHash": "59fd4e060efa999b7b1406771c5241703e2daa17bbc9a0371780de0a5f236bed",
              "officeSlots": [
                1
              ],
              "partyId": "1acb27bc-6d9c-4974-abf5-9249d4883d86"
            }
          ],
          "requiredOffices": [
            "chair",
            "member"
          ],
          "requiredSignatures": 2,
          "ruleTextHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "method": "PUT",
        "path": "/api/v1/parties/171f78d9-a747-4730-b804-535f93d93efa/statutory-representation"
      },
      "response": {
        "status": 200
      }
    },
    {
      "description": "POST a registry mandate preserving a three-signature statutory quorum",
      "providerStates": [
        {
          "name": "an active company and natural person exist for a joint KYB mandate"
        }
      ],
      "request": {
        "body": {
          "agentPartyId": "d1d1d1d1-e2e2-4f4f-8a8a-b1b1b1b1b1b1",
          "authority": "JOINT",
          "evidenceRef": "kyb-case:pact-joint-3",
          "requiredSignatures": 3,
          "role": "LEGAL_REPRESENTATIVE",
          "source": "REGISTRY"
        },
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.requiredSignatures": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/v1/parties/c1c1c1c1-d2d2-4e4e-8f8f-a1a1a1a1a1a1/mandates"
      },
      "response": {
        "body": {
          "agentPartyId": "d1d1d1d1-e2e2-4f4f-8a8a-b1b1b1b1b1b1",
          "authority": "JOINT",
          "evidenceRef": "kyb-case:pact-joint-3",
          "id": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
          "principalPartyId": "c1c1c1c1-d2d2-4e4e-8f8f-a1a1a1a1a1a1",
          "requiredSignatures": 3,
          "role": "LEGAL_REPRESENTATIVE",
          "source": "REGISTRY",
          "status": "ACTIVE"
        },
        "generators": {
          "body": {
            "$.id": {
              "type": "Uuid"
            }
          }
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.requiredSignatures": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 201
      }
    },
    {
      "description": "POST a mandate for a legal entity the bank does not hold",
      "providerStates": [
        {
          "name": "no party exists for the KYB mandate principal"
        }
      ],
      "request": {
        "body": {
          "agentPartyId": "d1d1d1d1-e2e2-4f4f-8a8a-b1b1b1b1b1b1",
          "authority": "JOINT",
          "evidenceRef": "kyb-case:pact-missing",
          "requiredSignatures": 3,
          "role": "LEGAL_REPRESENTATIVE",
          "source": "REGISTRY"
        },
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.requiredSignatures": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/api/v1/parties/00000000-0000-4000-8000-000000000284/mandates"
      },
      "response": {
        "status": 404
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-party-service"
  }
}
