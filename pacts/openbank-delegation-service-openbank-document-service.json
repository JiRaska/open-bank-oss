      "response": {
        "body": "JVBERi0xLjcgc2VhbGVkIGRpc2Nsb3N1cmU=",
        "headers": {
          "Cache-Control": "private, no-store",
          "Content-Type": "application/pdf",
          "ETag": "\"397f16a0e617d2898c400f7c9db43b117395f2518b348d563b603d8aa35f6399\""
        },
        "status": 200
