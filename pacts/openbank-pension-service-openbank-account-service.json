{
  "consumer": {
    "name": "openbank-pension-service"
  },
  "interactions": [
    {
      "description": "GET the account behind a pension payout IBAN",
      "providerStates": [
        {
          "name": "an account owned by a known party exists"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/accounts/iban/CZ6508000000192000145399"
      },
      "response": {
        "body": {
          "partyId": "66666666-7777-4888-8999-aaaaaaaaaaaa",
          "status": "ACTIVE"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    },
    {
      "description": "GET the account behind a pension payout IBAN the bank does not hold",
      "providerStates": [
        {
          "name": "no account exists for the IBAN"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/accounts/iban/CZ5508000000001234567899"
      },
      "response": {
        "status": 404
      }
    },
    {
      "description": "GET an account by IBAN for pension with no M2M identity is refused",
      "providerStates": [
        {
          "name": "no valid M2M identity is presented"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/accounts/iban/CZ6508000000192000145399"
      },
      "response": {
        "status": 401
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.3"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "openbank-account-service"
  }
}
