{
  "pack": "mcp-redteam",
  "version": "v1",
  "comment": "Scenario ids are corpus items (openbank-mcp-service/src/test/resources/redteam/poisoned-corpus.json). allowed_tool_calls is set per scenario to the tool that answers the question.",
