# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.kt          text eol=lf diff=kotlin
*.kts         text eol=lf diff=kotlin
*.java        text eol=lf diff=java
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.md          text eol=lf
*.sql         text eol=lf
*.sh          text eol=lf
*.properties  text eol=lf
*.tf          text eol=lf
*.tfvars      text eol=lf
*.avsc        text eol=lf
*.proto       text eol=lf
Dockerfile*   text eol=lf
Makefile      text eol=lf
gradlew       text eol=lf

# Windows scripts keep CRLF
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# Binary files (never diff)
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.pdf         binary
*.jar         binary
*.war         binary
*.ear         binary
*.zip         binary
*.tar.gz      binary
*.tgz         binary
*.p12         binary
*.pfx         binary
*.jks         binary
*.keystore    binary

# Generated / lock files — don't show in diff by default
package-lock.json   linguist-generated=true
pnpm-lock.yaml      linguist-generated=true
yarn.lock           linguist-generated=true
**/generated/**     linguist-generated=true

# Exclude vendor / generated from language stats
node_modules/**     linguist-vendored=true
**/build/**         linguist-generated=true
