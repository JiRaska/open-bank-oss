{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbank.example/contracts/swift/treasury-payment-released.schema.json",
  "title": "treasury.payment.released.v1",
  "x-openbank-event-type": "treasury.payment.released.v1",
  "description": "Contract 9.1 as the bank-own rail (swift-service) consumes it from openbank.treasury.payments. Produced by treasury-service. Unknown fields are tolerated (additive evolution); the constraints below are the ones the rail enforces, each refused with the ISO 20022 reason code in x-openbank-reason-code.",
  "type": "object",
  "required": ["paymentId", "idempotencyKey", "rail", "currency", "amount", "valueDate", "debtor", "creditor", "dealIds", "flowIds", "releasedBy", "releasedAt", "synthetic"],
  "properties": {
    "paymentId": { "type": "string", "format": "uuid", "x-openbank-reason-code": "FF01" },
    "idempotencyKey": { "type": "string", "maxLength": 255, "pattern": "^treasury:[A-Za-z0-9:._-]+:payment$", "x-openbank-reason-code": "FF01" },
    "rail": { "type": "string", "enum": ["CERTIS", "TARGET2", "SWIFT"], "x-openbank-reason-code": "FF01" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217; CERTIS clears CZK only, TARGET2 EUR only.", "x-openbank-reason-code": "AM03" },
    "amount": { "type": "string", "pattern": "^[0-9]{1,15}\\.[0-9]{2}$", "description": "Positive, exactly two decimals, representable in the currency's minor unit.", "x-openbank-reason-code": "AM12" },
    "valueDate": { "type": "string", "format": "date", "description": "Not earlier than today minus the configured tolerance (default 1 day).", "x-openbank-reason-code": "DT01" },
    "debtor": {
      "type": "object",
      "required": ["bic", "accountNumber", "glAccountingClass"],
      "properties": {
        "bic": { "$ref": "#/$defs/bic" },
        "accountNumber": { "$ref": "#/$defs/account" },
        "glAccountingClass": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "creditor": {
      "type": "object",
      "required": ["bic", "accountNumber", "name"],
      "properties": {
        "bic": { "$ref": "#/$defs/bic" },
        "accountNumber": { "$ref": "#/$defs/account" },
        "name": { "type": "string", "minLength": 1, "maxLength": 140 }
      }
    },
    "intermediaryBic": { "oneOf": [{ "$ref": "#/$defs/bic" }, { "type": "null" }] },
    "remittanceInformation": { "type": ["string", "null"], "minLength": 1, "maxLength": 140 },
    "dealIds": { "type": "array", "maxItems": 500, "items": { "type": "string", "format": "uuid" } },
    "flowIds": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "type": "string", "format": "uuid" } },
    "releasedBy": { "type": "string", "minLength": 1, "maxLength": 255 },
    "releasedAt": { "type": "string", "format": "date-time" },
    "synthetic": { "type": "boolean" },
    "ssiVersion": { "type": ["integer", "null"], "minimum": 1, "description": "Optional (9.1 addendum): the counterparty SSI version the creditor block was taken from. Echoed on every 9.2 status event." }
  },
  "additionalProperties": true,
  "$defs": {
    "bic": { "type": "string", "pattern": "^[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?$", "x-openbank-reason-code": "RC01" },
    "account": { "type": "string", "maxLength": 34, "description": "An IBAN with a valid mod-97 check, or a plain domestic account number.", "x-openbank-reason-code": "AC01" }
  }
}
