{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:catalog-schema:org.openbank.insurance.term-life:2",
  "type": "object",
  "additionalProperties": false,
  "required": ["coverage", "termYears", "premiumModel", "perils", "exclusions", "limits", "deductibles", "underwritingQuestions"],
  "properties": {
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["amount", "currency"],
      "properties": {"amount": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]+)?$"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}
    },
    "termYears": {"type": "integer", "minimum": 1, "maximum": 80},
    "smokerAccepted": {"type": "boolean"},
    "perils": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"type": "object", "additionalProperties": false, "required": ["code", "description"], "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}, "description": {"type": "string", "minLength": 1, "maxLength": 1024}}}
    },
    "exclusions": {
      "type": "array", "maxItems": 64,
      "items": {"type": "object", "additionalProperties": false, "required": ["code", "description"], "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}, "description": {"type": "string", "minLength": 1, "maxLength": 1024}}}
    },
    "limits": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"type": "object", "additionalProperties": false, "required": ["kind", "amount", "currency"], "properties": {"kind": {"type": "string", "enum": ["PER_EVENT", "AGGREGATE"]}, "amount": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]+)?$"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}}
    },
    "deductibles": {
      "type": "array", "maxItems": 16,
      "items": {"type": "object", "additionalProperties": false, "required": ["kind", "amount", "currency"], "properties": {"kind": {"type": "string", "enum": ["PER_CLAIM", "AGGREGATE"]}, "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}}
    },
    "underwritingQuestions": {
      "type": "array", "maxItems": 64,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "question", "answerType", "required"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"}, "question": {"type": "string", "minLength": 1, "maxLength": 1024}, "answerType": {"type": "string", "enum": ["BOOLEAN", "NUMBER", "TEXT", "CHOICE"]}, "required": {"type": "boolean"}}}
    },
    "premiumModel": {"type": "string", "enum": ["FIXED", "CALCULATED"]},
    "premium": {
      "type": "object", "additionalProperties": false, "required": ["amount", "currency", "cadence"],
      "properties": {"amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "cadence": {"type": "string", "enum": ["MONTHLY", "ANNUALLY"]}}
    }
  },
  "allOf": [{"if": {"properties": {"premiumModel": {"const": "FIXED"}}}, "then": {"required": ["premium"]}}]
}
