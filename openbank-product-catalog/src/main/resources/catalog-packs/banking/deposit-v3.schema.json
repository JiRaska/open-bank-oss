{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:catalog-schema:org.openbank.banking.deposit:3",
  "$comment": "ADR-0341 v3: adds the closed accountingClass and regulatoryClass every pinned revision must carry. v2 stays registered, so published v2 revisions are untouched.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "currency",
    "productType",
    "interest",
    "accountingClass",
    "regulatoryClass"
  ],
  "properties": {
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "productType": {
      "type": "string",
      "enum": [
        "SAVINGS",
        "CURRENT",
        "TERM_DEPOSIT"
      ]
    },
    "minimumBalance": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "interest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rateType",
        "dayCount",
        "payoutFrequency"
      ],
      "properties": {
        "rateType": {
          "type": "string",
          "enum": [
            "FIXED",
            "TIERED"
          ]
        },
        "dayCount": {
          "type": "string",
          "enum": [
            "ACT_365",
            "ACT_360",
            "ACT_ACT",
            "THIRTY_360"
          ]
        },
        "payoutFrequency": {
          "type": "string",
          "enum": [
            "MONTHLY",
            "QUARTERLY",
            "ANNUALLY",
            "AT_MATURITY"
          ]
        },
        "annualRate": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fromBalance",
              "annualRate"
            ],
            "properties": {
              "fromBalance": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "toBalance": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "annualRate": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "rateType": {
                "const": "FIXED"
              }
            }
          },
          "then": {
            "required": [
              "annualRate"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "rateType": {
                "const": "TIERED"
              }
            }
          },
          "then": {
            "required": [
              "tiers"
            ]
          }
        }
      ]
    },
    "accountingClass": {
      "type": "string",
      "enum": [
        "CUSTOMER_DEPOSIT_DEMAND",
        "CUSTOMER_DEPOSIT_SAVINGS",
        "CUSTOMER_DEPOSIT_TERM"
      ],
      "description": "ADR-0341 accounting class. The ledger maps it to GL accounts; a revision never carries GL codes."
    },
    "regulatoryClass": {
      "type": "object",
      "additionalProperties": false,
      "description": "ADR-0341 regulatory class drawn from the FINREP / AnaCredit taxonomies.",
      "required": [
        "finrepInstrument",
        "counterpartySector"
      ],
      "properties": {
        "finrepInstrument": {
          "type": "string",
          "enum": [
            "DEPOSITS_OVERNIGHT",
            "DEPOSITS_REDEEMABLE_AT_NOTICE",
            "DEPOSITS_WITH_AGREED_MATURITY"
          ]
        },
        "counterpartySector": {
          "type": "string",
          "enum": [
            "HOUSEHOLDS",
            "NON_FINANCIAL_CORPORATIONS",
            "CREDIT_INSTITUTIONS",
            "CENTRAL_BANK",
            "GENERAL_GOVERNMENT",
            "OTHER_FINANCIAL_CORPORATIONS",
            "PER_PARTY"
          ]
        }
      }
    }
  }
}
