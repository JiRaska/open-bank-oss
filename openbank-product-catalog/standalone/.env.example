# Copy to .env and provide values locally. Never commit the populated file.
CATALOG_IMAGE=
POSTGRES_USER=
POSTGRES_PASSWORD=
OIDC_ISSUER=

# Empty is the safe, industry-neutral default. Examples: insurance or banking,insurance
OPENBANK_CATALOG_PACKS=
# Enable only with the banking pack when legacy /api/v1 consumers are required.
OPENBANK_BANK_V1_COMPATIBILITY_ENABLED=false
CATALOG_PORT=8104
MANAGEMENT_PORT=8085

# Optional `docker compose --profile studio up -d` reference UI (Keycloak adapter).
# Required only for `--profile studio`; use a released immutable tag/digest from your UI build lane.
STUDIO_IMAGE=
STUDIO_PUBLIC_URL=http://localhost:3000
# Localhost-only development escape; remote production URLs must always use HTTPS.
ALLOW_INSECURE_STUDIO_URLS=true
STUDIO_AUTH_SECRET=
STUDIO_KEYCLOAK_URL=
STUDIO_KEYCLOAK_REALM=openbank
STUDIO_KEYCLOAK_CLIENT_ID=openbank-product-studio
STUDIO_KEYCLOAK_CLIENT_SECRET=
STUDIO_PORT=3000
