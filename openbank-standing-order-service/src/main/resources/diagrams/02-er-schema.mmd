%% title: Standing Order Service ER Schema
erDiagram
    standing_orders {
        UUID id PK
        VARCHAR idempotency_key UK
        UUID party_id
        UUID debit_account_id
        VARCHAR creditor_iban
        VARCHAR creditor_name
        VARCHAR creditor_bic
        BIGINT amount_minor_units
        CHAR_3 currency
        VARCHAR frequency "DAILY|WEEKLY|BIWEEKLY|MONTHLY|QUARTERLY|ANNUALLY"
        VARCHAR payment_type "SEPA_CREDIT|DOMESTIC|INTERNAL"
        VARCHAR remittance_info
        DATE start_date
        DATE end_date
        DATE next_execution_date
        DATE last_execution_date
        INTEGER execution_count
        INTEGER failure_count
        VARCHAR status "ACTIVE|PAUSED|CANCELLED|COMPLETED|FAILED"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    standing_order_outbox {
        BIGSERIAL id PK
        UUID event_id UK
        UUID aggregate_id
        VARCHAR event_type
        TEXT payload
        VARCHAR status "PENDING|SENT|FAILED"
        INTEGER attempt_count
        TIMESTAMPTZ sent_at
        TEXT last_error
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    standing_orders ||--o{ standing_order_outbox : "aggregate_id"
