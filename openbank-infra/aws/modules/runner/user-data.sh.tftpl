#!/usr/bin/env bash
# Boot script for the openbank self-hosted GitHub Actions runner.
# Reads a temporary registration token from SSM, registers the runner as a
# systemd service, then deletes the SSM parameter so the token persists nowhere.
set -euo pipefail
exec > >(tee /var/log/openbank-runner-bootstrap.log) 2>&1

REPO="${github_repo}"
RUNNER_NAME="${runner_name}"
RUNNER_LABELS="${runner_labels}"
REG_TOKEN_PARAM="${reg_token_param}"
AWS_REGION="${aws_region}"
RUNNER_USER="ghrunner"
RUNNER_HOME="/opt/actions-runner"

dnf -y update
dnf -y install jq tar gzip git libicu awscli docker
systemctl enable --now docker

# Raise fs.aio-max-nr so Redpanda/Kafka Testcontainers can allocate their async-I/O
# contexts (ADR-0082). The distro default (65536) is exhausted by concurrent dind
# containers, killing Redpanda at startup ("Could not setup Async I/O ... aio-max-nr
# (Resource temporarily unavailable)") and flaking *ApiIT/Pact tests. Mirrors the ARC
# init-aio-sysctl and scripts/tune-runner-host.sh; non-namespaced kernel param → host-level.
echo 'fs.aio-max-nr = 1048576' > /etc/sysctl.d/99-openbank-runner-aio.conf
sysctl -p /etc/sysctl.d/99-openbank-runner-aio.conf

# Docker Compose v2 is a Docker CLI plugin, not part of the Amazon Linux 2023
# `docker` package. The per-service CI jobs boot openbank-infra/docker-compose.yml
# via `docker compose`, so install the plugin binary into the cli-plugins dir;
# without it `docker compose ...` fails with "unknown shorthand flag: 'f' in -f".
COMPOSE_PLUGIN_DIR="/usr/libexec/docker/cli-plugins"
mkdir -p "$COMPOSE_PLUGIN_DIR"
COMPOSE_VERSION="$(curl -fsSL https://api.github.com/repos/docker/compose/releases/latest | jq -r '.tag_name')"
curl -fsSL -o "$COMPOSE_PLUGIN_DIR/docker-compose" \
  "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-$(uname -m)"
chmod +x "$COMPOSE_PLUGIN_DIR/docker-compose"
docker compose version

# ---------------------------------------------------------------------------
# CI tool dependencies, baked into the box so jobs never fail (or re-download on
# every run) for a missing host binary. Arch token ${runner_arch} is "arm64"/"x64".
#   - gitleaks  : secret scanning. The security workflow otherwise curls it into
#                 /tmp every run — slow, and a known flakiness source (stale /tmp).
#   - yamllint  : manifest linting ("Validate manifests" job).
#   - shellcheck: shell linting. Ships only x86_64/aarch64 assets, so map the arch;
#                 baking it on arm64 lets the manifest-validate job leave the x64
#                 runner (the x64 box then exists only for CodeQL, which is free on
#                 GitHub-hosted ubuntu once the repo is public).
# ---------------------------------------------------------------------------
dnf -y install python3-pip xz
# Pinned + hash-verified (OpenSSF Scorecard Pinned-Dependencies: pipCommand), including
# yamllint's own transitive deps (pathspec, pyyaml) since --require-hashes mode needs
# every resolved package pinned, not just the top-level one.
cat > /tmp/yamllint-requirements.txt <<'EOF'
yamllint==1.35.1 \
    --hash=sha256:2e16e504bb129ff515b37823b472750b36b6de07963bd74b307341ef5ad8bdc3 \
    --hash=sha256:7a003809f88324fd2c877734f2d575ee7881dd9043360657cc8049c809eba6cd
pathspec==1.1.1 \
    --hash=sha256:a00ce642f577bf7f473932318056212bc4f8bfdf53128c78bbd5af0b9b20b189 \
    --hash=sha256:17db5ecd524104a120e173814c90367a96a98d07c45b2e10c2f3919fff91bf5a
pyyaml==6.0.2 \
    --hash=sha256:0a9a2848a5b7feac301353437eb7d5957887edbf81d56e903999a75a3d743086 \
    --hash=sha256:29717114e51c84ddfba879543fb232a6ed60086602313ca38cce623c1d62cfbf \
    --hash=sha256:8824b5a04a04a047e72eea5cec3bc266db09e35de6bdfe34c9436ac5ee27d237 \
    --hash=sha256:7c36280e6fb8385e520936c3cb3b8042851904eba0e58d277dca80a5cfed590b \
    --hash=sha256:ec031d5d2feb36d1d1a24380e4db6d43695f3748343d99434e6f5f9156aaa2ed \
    --hash=sha256:936d68689298c36b53b29f23c6dbb74de12b4ac12ca6cfe0e047bedceea56180 \
    --hash=sha256:23502f431948090f597378482b4812b0caae32c22213aecf3b55325e049a6c68 \
    --hash=sha256:2e99c6826ffa974fe6e27cdb5ed0021786b03fc98e5ee3c5bfe1fd5015f42b99 \
    --hash=sha256:a4d3091415f010369ae4ed1fc6b79def9416358877534caf6a0fdd2146c87a3e \
    --hash=sha256:cc1c1159b3d456576af7a3e4d1ba7e6924cb39de8f67111c735f6fc832082774 \
    --hash=sha256:1e2120ef853f59c7419231f3bf4e7021f1b936f6ebd222406c3b60212205d2ee \
    --hash=sha256:5d225db5a45f21e78dd9358e58a98702a0302f2659a3c6cd320564b75b86f47c \
    --hash=sha256:5ac9328ec4831237bec75defaf839f7d4564be1e6b25ac710bd1a96321cc8317 \
    --hash=sha256:3ad2a3decf9aaba3d29c8f537ac4b243e36bef957511b4766cb0057d32b0be85 \
    --hash=sha256:ff3824dc5261f50c9b0dfb3be22b4567a6f938ccce4587b38952d85fd9e9afe4 \
    --hash=sha256:797b4f722ffa07cc8d62053e4cff1486fa6dc094105d13fea7b1de7d8bf71c9e \
    --hash=sha256:11d8f3dd2b9c1207dcaf2ee0bbbfd5991f571186ec9cc78427ba5bd32afae4b5 \
    --hash=sha256:e10ce637b18caea04431ce14fabcf5c64a1c61ec9c56b071a4b7ca131ca52d44 \
    --hash=sha256:c70c95198c015b85feafc136515252a261a84561b7b1d51e3384e0655ddf25ab \
    --hash=sha256:ce826d6ef20b1bc864f0a68340c8b3287705cae2f8b4b1d932177dcc76721725 \
    --hash=sha256:1f71ea527786de97d1a0cc0eacd1defc0985dcf6b3f17bb77dcfc8c34bec4dc5 \
    --hash=sha256:9b22676e8097e9e22e36d6b7bda33190d0d400f345f23d4065d48f4ca7ae0425 \
    --hash=sha256:80bab7bfc629882493af4aa31a4cfa43a4c57c83813253626916b8c7ada83476 \
    --hash=sha256:0833f8694549e586547b576dcfaba4a6b55b9e96098b36cdc7ebefe667dfed48 \
    --hash=sha256:8b9c7197f7cb2738065c481a0461e50ad02f18c78cd75775628afb4d7137fb3b \
    --hash=sha256:ef6107725bd54b262d6dedcc2af448a266975032bc85ef0172c5f059da6325b4 \
    --hash=sha256:7e7401d0de89a9a855c839bc697c079a4af81cf878373abd7dc625847d25cbd8 \
    --hash=sha256:efdca5630322a10774e8e98e1af481aad470dd62c3170801852d752aa7a783ba \
    --hash=sha256:50187695423ffe49e2deacb8cd10510bc361faac997de9efef88badc3bb9e2d1 \
    --hash=sha256:0ffe8360bab4910ef1b9e87fb812d8bc0a308b0d0eef8c8f44e0254ab3b07133 \
    --hash=sha256:17e311b6c678207928d649faa7cb0d7b4c26a0ba73d41e99c4fff6b6c3276484 \
    --hash=sha256:70b189594dbe54f75ab3a1acec5f1e3faa7e8cf2f1e08d9b561cb41b845f69d5 \
    --hash=sha256:41e4e3953a79407c794916fa277a82531dd93aad34e29c2a514c2c0c5fe971cc \
    --hash=sha256:68ccc6023a3400877818152ad9a1033e3db8625d899c72eacb5a668902e4d652 \
    --hash=sha256:bc2fa7c6b47d6bc618dd7fb02ef6fdedb1090ec036abab80d4681424b84c1183 \
    --hash=sha256:8388ee1976c416731879ac16da0aff3f63b286ffdd57cdeb95f3f2e085687563 \
    --hash=sha256:24471b829b3bf607e04e88d79542a9d48bb037c2267d7927a874e6c205ca7e9a \
    --hash=sha256:d7fded462629cfa4b685c5416b949ebad6cec74af5e2d42905d41e257e0869f5 \
    --hash=sha256:d84a1718ee396f54f3a086ea0a66d8e552b2ab2017ef8b420e92edbc841c352d \
    --hash=sha256:9056c1ecd25795207ad294bcf39f2db3d845767be0ea6e6a34d856f006006083 \
    --hash=sha256:82d09873e40955485746739bcb8b4586983670466c23382c19cffecbf1fd8706 \
    --hash=sha256:43fa96a3ca0d6b1812e01ced1044a003533c47f6ee8aca31724f78e93ccc089a \
    --hash=sha256:01179a4a8559ab5de078078f37e5c1a30d76bb88519906844fd7bdea1b7729ff \
    --hash=sha256:688ba32a1cffef67fd2e9398a2efebaea461578b0923624778664cc1c914db5d \
    --hash=sha256:a8786accb172bd8afb8be14490a16625cbc387036876ab6ba70912730faf8e1f \
    --hash=sha256:d8e03406cac8513435335dbab54c0d385e4a49e4945d2909a581c83647ca0290 \
    --hash=sha256:f753120cb8181e736c57ef7636e83f31b9c0d1722c516f7e86cf15b7aa57ff12 \
    --hash=sha256:3b1fdb9dc17f5a7677423d508ab4f243a726dea51fa5e70992e59a7411c89d19 \
    --hash=sha256:0b69e4ce7a131fe56b7e4d770c67429700908fc0752af059838b1cfb41960e4e \
    --hash=sha256:a9f8c2e67970f13b16084e04f134610fd1d374bf477b17ec1599185cf611d725 \
    --hash=sha256:6395c297d42274772abc367baaa79683958044e5d3835486c16da75d2a694631 \
    --hash=sha256:39693e1f8320ae4f43943590b49779ffb98acb81f788220ea932a6b6c51004d8 \
    --hash=sha256:d584d9ec91ad65861cc08d42e834324ef890a082e591037abe114850ff7bbc3e
EOF
pip3 install --quiet --require-hashes -r /tmp/yamllint-requirements.txt

GITLEAKS_VERSION="$(curl -fsSL https://api.github.com/repos/gitleaks/gitleaks/releases/latest | jq -r '.tag_name' | sed 's/^v//')"
curl -fsSL -o /tmp/gitleaks.tar.gz \
  "https://github.com/gitleaks/gitleaks/releases/download/v$${GITLEAKS_VERSION}/gitleaks_$${GITLEAKS_VERSION}_linux_${runner_arch}.tar.gz"
tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks
chmod +x /usr/local/bin/gitleaks
gitleaks version

case "${runner_arch}" in
  arm64) SC_ARCH="aarch64" ;;
  x64) SC_ARCH="x86_64" ;;
esac
SHELLCHECK_VERSION="$(curl -fsSL https://api.github.com/repos/koalaman/shellcheck/releases/latest | jq -r '.tag_name')"
curl -fsSL -o /tmp/shellcheck.tar.xz \
  "https://github.com/koalaman/shellcheck/releases/download/$${SHELLCHECK_VERSION}/shellcheck-$${SHELLCHECK_VERSION}.linux.$${SC_ARCH}.tar.xz"
tar -xJf /tmp/shellcheck.tar.xz -C /tmp
install -m 0755 "/tmp/shellcheck-$${SHELLCHECK_VERSION}/shellcheck" /usr/local/bin/shellcheck
shellcheck --version

# Trivy: container/filesystem vuln scanning AND SBOM generation (the security
# workflow runs `trivy fs` and emits a CycloneDX SBOM, so this one binary covers
# both the Trivy and SBOM jobs). Pinned to the v0.63.0 tag (not `main`, matching
# auto-deploy.yml's Install Trivy step) and hash-verified before execution
# (OpenSSF Scorecard Pinned-Dependencies: downloadThenRun).
curl -fsSL https://raw.githubusercontent.com/aquasecurity/trivy/v0.63.0/contrib/install.sh -o /tmp/trivy-install.sh
echo "2304dcc0c1883e802d376eae1b514c923b7427a7d88091dfcaf83967e6f55a7c  /tmp/trivy-install.sh" | sha256sum -c -
sh /tmp/trivy-install.sh -b /usr/local/bin
trivy --version

id -u "$RUNNER_USER" &>/dev/null || useradd -m -s /bin/bash "$RUNNER_USER"
usermod -aG docker "$RUNNER_USER"

# Latest runner release for this architecture (${runner_arch}).
RUNNER_VERSION="$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest \
  | jq -r '.tag_name' | sed 's/^v//')"

mkdir -p "$RUNNER_HOME"
curl -fsSL -o /tmp/runner.tar.gz \
  "https://github.com/actions/runner/releases/download/v$${RUNNER_VERSION}/actions-runner-linux-${runner_arch}-$${RUNNER_VERSION}.tar.gz"
tar -xzf /tmp/runner.tar.gz -C "$RUNNER_HOME"
chown -R "$RUNNER_USER:$RUNNER_USER" "$RUNNER_HOME"

# Always delete the one-shot token parameter, even if registration fails.
trap 'aws ssm delete-parameter --region "$AWS_REGION" --name "$REG_TOKEN_PARAM" >/dev/null 2>&1 || true' EXIT

# Read the short-lived registration token (decrypted) via the instance role.
REG_TOKEN="$(aws ssm get-parameter --region "$AWS_REGION" --name "$REG_TOKEN_PARAM" \
  --with-decryption --query 'Parameter.Value' --output text)"

# config.sh and svc.sh must both run from the runner root directory.
cd "$RUNNER_HOME"

sudo -u "$RUNNER_USER" ./config.sh \
  --unattended \
  --url "https://github.com/$${REPO}" \
  --token "$REG_TOKEN" \
  --name "$RUNNER_NAME" \
  --labels "$RUNNER_LABELS" \
  --work "_work" \
  --replace

unset REG_TOKEN

# svc.sh installs the systemd unit (runs as root) for the given run-as user.
./svc.sh install "$RUNNER_USER"

# svc.sh enables the unit, but the generated unit carries no Restart= directive
# and no ordering against the network/docker. After a stop/start or instance-type
# change (this box is meant to be stopped when idle per the README cost note), a
# boot-time race can start the runner before egress/docker is up; it then exits
# and — with nothing to restart it — stays dead, silently breaking CI until a
# manual reboot. A drop-in makes it wait for the network and always restart, so
# the "survives reboots" promise actually holds.
SVC_NAME="$(cat "$RUNNER_HOME/.service")"
install -d "/etc/systemd/system/$${SVC_NAME}.d"
cat > "/etc/systemd/system/$${SVC_NAME}.d/10-openbank-resilience.conf" <<'UNIT'
[Unit]
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Restart=always
RestartSec=10
UNIT
systemctl daemon-reload

./svc.sh start
