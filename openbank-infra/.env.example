# OpenBank Local Development Environment Variables
#
# SECURITY POLICY:
#   1. Copy this file to `.env` (which is gitignored) before running `docker compose up`.
#   2. These values are for LOCAL DEVELOPMENT ONLY. Production secrets MUST come from
#      OpenBao / AWS Secrets Manager / GCP Secret Manager via Kubernetes External Secrets.
#   3. NEVER commit `.env` to git. NEVER reuse these dev values in any non-dev environment.
#   4. Rotate immediately if any value here ever appears in a shared environment.
#
# AUDIT: All production credentials are rotated automatically via OpenBao dynamic secrets
#        (TTL <= 24h) per PCI DSS v4.0 Req. 8.3.10 and CNB 21/1992 § 8c.

# --- PostgreSQL (shared DB cluster, dev only) ---
POSTGRES_PASSWORD=changeme_local_postgres_dev_only

# --- Valkey / Redis cache ---
VALKEY_PASSWORD=changeme_local_valkey_dev_only

# --- OpenBao (dev mode root token) ---
BAO_DEV_ROOT_TOKEN=changeme_local_openbao_root_dev_only

# --- Keycloak admin console (master realm) ---
ADMIN_PASSWORD=changeme_local_keycloak_admin_dev_only

# --- OIDC client secret used by all Quarkus services to authenticate to Keycloak ---
OIDC_CLIENT_SECRET=changeme_local_oidc_client_dev_only

# --- Admin UI (Next.js) ---
NEXTAUTH_SECRET=changeme_local_nextauth_dev_only
ADMIN_UI_CLIENT_SECRET=changeme_local_admin_ui_dev_only

# --- JWT signing secret used by services (HS256 in dev; prod uses RS256 with OpenBao-managed keys) ---
JWT_SECRET=changeme_local_jwt_signing_dev_only
