{
  "title": "OpenBank — Platform Overview",
  "uid": "openbank-overview",
  "tags": ["openbank"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "row", "title": "🏦 Service Health", "gridPos": {"h":1,"w":24,"x":0,"y":0}, "collapsed": false
    },
    {
      "id": 2, "type": "stat", "title": "Services UP",
      "gridPos": {"h":4,"w":4,"x":0,"y":1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none", "textMode": "auto"},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color":"red","value":0},{"color":"yellow","value":20},{"color":"green","value":23}]}, "mappings": []}},
      "targets": [{"expr": "count(up == 1)", "legendFormat": "UP", "datasource": "Prometheus"}]
    },
    {
      "id": 3, "type": "stat", "title": "Services DOWN",
      "gridPos": {"h":4,"w":4,"x":4,"y":1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color":"green","value":0},{"color":"red","value":1}]}, "mappings": []}},
      "targets": [{"expr": "count(up == 0) or vector(0)", "legendFormat": "DOWN", "datasource": "Prometheus"}]
    },
    {
      "id": 4, "type": "stat", "title": "Total RPS",
      "gridPos": {"h":4,"w":4,"x":8,"y":1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "reqps", "thresholds": {"steps": [{"color":"green","value":0}]}}},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count[1m]))", "legendFormat": "RPS", "datasource": "Prometheus"}]
    },
    {
      "id": 5, "type": "stat", "title": "P99 Latency",
      "gridPos": {"h":4,"w":4,"x":12,"y":1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color":"green","value":0},{"color":"yellow","value":0.5},{"color":"red","value":2}]}}},
      "targets": [{"expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))", "legendFormat": "P99", "datasource": "Prometheus"}]
    },
    {
      "id": 6, "type": "stat", "title": "Error Rate",
      "gridPos": {"h":4,"w":4,"x":16,"y":1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color":"green","value":0},{"color":"yellow","value":0.01},{"color":"red","value":0.05}]}}},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{outcome='SERVER_ERROR'}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))", "legendFormat": "Error %", "datasource": "Prometheus"}]
    },
    {
      "id": 7, "type": "stat", "title": "JVM Heap (avg)",
      "gridPos": {"h":4,"w":4,"x":20,"y":1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color":"green","value":0},{"color":"yellow","value":0.7},{"color":"red","value":0.85}]}}},
      "targets": [{"expr": "avg(jvm_memory_used_bytes{area='heap'} / jvm_memory_max_bytes{area='heap'})", "legendFormat": "Heap %", "datasource": "Prometheus"}]
    },
    {
      "id": 10, "type": "row", "title": "📈 Request Rate by Service", "gridPos": {"h":1,"w":24,"x":0,"y":5}, "collapsed": false
    },
    {
      "id": 11, "type": "timeseries", "title": "HTTP Requests per Second — All Services",
      "gridPos": {"h":8,"w":24,"x":0,"y":6},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull","mean"]}},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 1}}},
      "targets": [
        {"expr": "sum(rate(http_server_requests_seconds_count[1m])) by (job)", "legendFormat": "{{job}}", "datasource": "Prometheus"}
      ]
    },
    {
      "id": 20, "type": "row", "title": "⏱ Latency Heatmap", "gridPos": {"h":1,"w":24,"x":0,"y":14}, "collapsed": false
    },
    {
      "id": 21, "type": "timeseries", "title": "P50 / P95 / P99 Latency — All Services",
      "gridPos": {"h":8,"w":24,"x":0,"y":15},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull","mean"]}},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 1}}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket[5m])) by (job, le))", "legendFormat": "p50 {{job}}", "datasource": "Prometheus"},
        {"expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (job, le))", "legendFormat": "p95 {{job}}", "datasource": "Prometheus"},
        {"expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (job, le))", "legendFormat": "p99 {{job}}", "datasource": "Prometheus"}
      ]
    },
    {
      "id": 30, "type": "row", "title": "☕ JVM Metrics", "gridPos": {"h":1,"w":24,"x":0,"y":23}, "collapsed": false
    },
    {
      "id": 31, "type": "timeseries", "title": "JVM Heap Usage by Service",
      "gridPos": {"h":7,"w":12,"x":0,"y":24},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 1}}},
      "targets": [
        {"expr": "jvm_memory_used_bytes{area='heap'}", "legendFormat": "{{job}}", "datasource": "Prometheus"}
      ]
    },
    {
      "id": 32, "type": "timeseries", "title": "JVM Threads by Service",
      "gridPos": {"h":7,"w":12,"x":12,"y":24},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"lineWidth": 1}}},
      "targets": [
        {"expr": "jvm_threads_live_threads", "legendFormat": "{{job}}", "datasource": "Prometheus"}
      ]
    },
    {
      "id": 40, "type": "row", "title": "🔒 Compliance & Security", "gridPos": {"h":1,"w":24,"x":0,"y":31}, "collapsed": false
    },
    {
      "id": 41, "type": "stat", "title": "AML Service",
      "gridPos": {"h":3,"w":4,"x":0,"y":32},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='aml-service'}", "legendFormat": "", "datasource": "Prometheus"}]
    },
    {
      "id": 42, "type": "stat", "title": "Sanctions Service",
      "gridPos": {"h":3,"w":4,"x":4,"y":32},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='sanctions-service'}", "legendFormat": "", "datasource": "Prometheus"}]
    },
    {
      "id": 43, "type": "stat", "title": "KYC Service",
      "gridPos": {"h":3,"w":4,"x":8,"y":32},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='kyc-service'}", "legendFormat": "", "datasource": "Prometheus"}]
    },
    {
      "id": 44, "type": "stat", "title": "Security Scanner",
      "gridPos": {"h":3,"w":4,"x":12,"y":32},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='security-scanner'}", "legendFormat": "", "datasource": "Prometheus"}]
    },
    {
      "id": 45, "type": "stat", "title": "Audit Service",
      "gridPos": {"h":3,"w":4,"x":16,"y":32},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='audit-service'}", "legendFormat": "", "datasource": "Prometheus"}]
    },
    {
      "id": 50, "type": "row", "title": "💳 New Services (8118-8123)", "gridPos": {"h":1,"w":24,"x":0,"y":35}, "collapsed": false
    },
    {
      "id": 51, "type": "timeseries", "title": "New Services — Request Rate",
      "gridPos": {"h":7,"w":12,"x":0,"y":36},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2}}},
      "targets": [
        {"expr": "sum(rate(http_server_requests_seconds_count[1m])) by (job)", "legendFormat": "{{job}}", "datasource": "Prometheus"}
      ]
    },
    {
      "id": 52, "type": "stat", "title": "Card Issuance",
      "gridPos": {"h":3,"w":4,"x":12,"y":36},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='card-issuance-service'}", "datasource": "Prometheus"}]
    },
    {
      "id": 53, "type": "stat", "title": "FX Service",
      "gridPos": {"h":3,"w":4,"x":16,"y":36},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='fx-service'}", "datasource": "Prometheus"}]
    },
    {
      "id": 54, "type": "stat", "title": "Standing Orders",
      "gridPos": {"h":3,"w":4,"x":20,"y":36},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='standing-order-service'}", "datasource": "Prometheus"}]
    },
    {
      "id": 55, "type": "stat", "title": "SWIFT",
      "gridPos": {"h":3,"w":4,"x":12,"y":39},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='swift-service'}", "datasource": "Prometheus"}]
    },
    {
      "id": 56, "type": "stat", "title": "Sanctions",
      "gridPos": {"h":3,"w":4,"x":16,"y":39},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='sanctions-service'}", "datasource": "Prometheus"}]
    }
  ]
}
