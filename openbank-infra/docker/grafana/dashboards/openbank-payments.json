{
  "title": "OpenBank — Payments & FX",
  "uid": "openbank-payments",
  "tags": ["openbank","payments"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "row", "title": "💸 Payment Services Health", "gridPos": {"h":1,"w":24,"x":0,"y":0}
    },
    {
      "id": 2, "type": "stat", "title": "SEPA",
      "gridPos": {"h":3,"w":4,"x":0,"y":1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='sepa-payment-service'}", "datasource": "Prometheus"}]
    },
    {
      "id": 3, "type": "stat", "title": "Domestic",
      "gridPos": {"h":3,"w":4,"x":4,"y":1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='domestic-payment-service'}", "datasource": "Prometheus"}]
    },
    {
      "id": 4, "type": "stat", "title": "SWIFT",
      "gridPos": {"h":3,"w":4,"x":8,"y":1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='swift-service'}", "datasource": "Prometheus"}]
    },
    {
      "id": 5, "type": "stat", "title": "Standing Orders",
      "gridPos": {"h":3,"w":4,"x":12,"y":1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='standing-order-service'}", "datasource": "Prometheus"}]
    },
    {
      "id": 6, "type": "stat", "title": "FX",
      "gridPos": {"h":3,"w":4,"x":16,"y":1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='fx-service'}", "datasource": "Prometheus"}]
    },
    {
      "id": 7, "type": "stat", "title": "AML",
      "gridPos": {"h":3,"w":4,"x":20,"y":1},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"1":{"text":"UP","color":"green"},"0":{"text":"DOWN","color":"red"}}}]}},
      "targets": [{"expr": "up{job='aml-service'}", "datasource": "Prometheus"}]
    },
    {
      "id": 10, "type": "row", "title": "📊 Payment Throughput", "gridPos": {"h":1,"w":24,"x":0,"y":4}
    },
    {
      "id": 11, "type": "timeseries", "title": "Payment Services — RPS",
      "gridPos": {"h":8,"w":24,"x":0,"y":5},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull","mean","max"]}},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2}}},
      "targets": [
        {"expr": "sum(rate(http_server_requests_seconds_count{job=~'sepa-payment-service|domestic-payment-service|swift-service|standing-order-service|fx-service|aml-service'}[1m])) by (job)", "legendFormat": "{{job}}", "datasource": "Prometheus"}
      ]
    },
    {
      "id": 20, "type": "row", "title": "⏱ Payment Latency", "gridPos": {"h":1,"w":24,"x":0,"y":13}
    },
    {
      "id": 21, "type": "timeseries", "title": "Payment Services — P99 Latency",
      "gridPos": {"h":8,"w":24,"x":0,"y":14},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull","mean"]}},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2}, "thresholds": {"steps": [{"color":"green","value":0},{"color":"yellow","value":1},{"color":"red","value":3}]}}},
      "targets": [
        {"expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=~'sepa-payment-service|domestic-payment-service|swift-service|standing-order-service|fx-service'}[5m])) by (job, le))", "legendFormat": "p99 {{job}}", "datasource": "Prometheus"}
      ]
    }
  ]
}
