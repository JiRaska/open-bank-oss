{
  "id": "openbank",
  "realm": "openbank",
  "displayName": "OpenBank",
  "displayNameHtml": "OpenBank Framework",
  "loginTheme": "openbank",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "ROLE_ADMIN",
        "description": "Bank administrator"
      },
      {
        "name": "ROLE_OPERATOR",
        "description": "Bank operator"
      },
      {
        "name": "ROLE_VIEWER",
        "description": "Read-only access"
      },
      {
        "name": "ROLE_API",
        "description": "Machine-to-machine API access"
      },
      {
        "name": "ROLE_KYC",
        "description": "KYC officer (legacy — use KYC_OPENER or KYC_REVIEWER for new assignments)"
      },
      {
        "name": "ROLE_KYC_OPENER",
        "description": "KYC case opener: initiates cases, submits documents, updates checks. Cannot approve/reject (four-eyes, ADR-0116)"
      },
      {
        "name": "ROLE_KYC_REVIEWER",
        "description": "KYC case reviewer: approves or rejects cases in UNDER_REVIEW. Must be different identity than opener (four-eyes, ADR-0116)"
      },
      {
        "name": "ROLE_COMPLIANCE",
        "description": "AML/KYC analyst: reads all PII unmasked, raises alerts, freezes accounts"
      },
      {
        "name": "ROLE_AUDITOR",
        "description": "Read-only access to audit trail (SOX/DORA evidence)"
      },
      {
        "name": "ROLE_SUPERVISOR",
        "description": "Approves limit overrides, large payments, board-level escalations"
      },
      {
        "name": "ROLE_PAYMENTS",
        "description": "Payment ops: initiation, recall, return, clearing reconciliation"
      },
      {
        "name": "ROLE_CREDIT_RISK",
        "description": "Credit-risk officer: takes the credit decision on a loan application (openbank-lending-service). Declared in @RolesAllowed since the service shipped; created here by issue #2442"
      },
      {
        "name": "ROLE_LENDING_OFFICER",
        "description": "Lending officer: opens and services loan applications, cannot take the credit decision (four-eyes with ROLE_CREDIT_RISK). Declared in @RolesAllowed since the service shipped; created here by issue #2442"
      },
      {
        "name": "ROLE_DEMO",
        "description": "Demo/guided-tour badge shown by the admin-UI (src/lib/auth/roles.ts). Existed in the live sandbox realm and in the docker dev realm but was missing here, so a cold-started cluster would not have it — added by the #2442 drift reconciliation"
      }
    ],
    "client": {
      "openbank-mcp-service": [
        {
          "name": "mcp-caller",
          "description": "May call MCP tools via an OBO-exchanged token (ADR-0224). Assignment to staff is operational, not realm-managed"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "admin-cli",
      "name": "${client_admin-cli}",
      "description": "Keycloak's built-in CLI/direct-grant client, declared explicitly so operator password-grant tokens carry realm_access — left to Keycloak's auto-created default (fullScopeAllowed=false, no scope mappings), it mints no realm roles at all (#5498).",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "realm roles (lightweight)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "openbank-admin-ui",
      "name": "OpenBank Admin UI",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://__ADMIN_HOST__/*"
      ],
      "webOrigins": [
        "https://__ADMIN_HOST__"
      ],
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "secret": "__ADMINUI_CLIENT_SECRET__"
    },
    {
      "clientId": "openbank-mcp-service",
      "name": "OpenBank MCP Service (OBO audience)",
      "description": "Audience target for RFC 8693 OBO-exchanged staff tokens (ADR-0224). Token-exchange scope permission granted to openbank-admin-ui only (verified on Keycloak 26.6.3)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "bearerOnly": false,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "secret": "__MCP_OBO_CLIENT_SECRET__",
      "authorizationSettings": {
        "allowRemoteResourceManagement": false,
        "policyEnforcementMode": "ENFORCING",
        "scopes": [
          {
            "name": "token-exchange"
          }
        ],
        "policies": [
          {
            "type": "client",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "name": "requester-openbank-admin-ui",
            "config": {
              "clients": "[\"openbank-admin-ui\"]"
            }
          },
          {
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "name": "token-exchange.openbank-mcp-service",
            "config": {
              "scopes": "[\"token-exchange\"]",
              "applyPolicies": "[\"requester-openbank-admin-ui\"]"
            }
          }
        ]
      }
    },
    {
      "clientId": "openbank-services",
      "name": "OpenBank Backend Services",
      "description": "Confidential client used by backend services (e.g. account-service) as an OIDC resource server validating bearer tokens.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "bearerOnly": false,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "secret": "__SERVICES_CLIENT_SECRET__"
    },
    {
      "clientId": "openbank-edge",
      "name": "OpenBank Customer Edge",
      "description": "M2M service-account client for the customer-facing edge proxy (ADR-0065). The edge validates customer JWTs from openbank-customers realm and uses this client (client_credentials) to call upstream backend services with an operator-realm token.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "bearerOnly": false,
      "defaultClientScopes": [
        "openid",
        "roles"
      ],
      "secret": "__EDGE_CLIENT_SECRET__"
    },
    {
      "clientId": "openbank-grafana",
      "name": "Grafana (observability single pane)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "https://admin.open-bank.tech/tools/grafana",
      "redirectUris": [
        "https://admin.open-bank.tech/tools/grafana/login/generic_oauth",
        "http://localhost:3000/login/generic_oauth"
      ],
      "webOrigins": [
        "https://admin.open-bank.tech",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles-userinfo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "openbank-glitchtip",
      "name": "GlitchTip (mobile crash sink SSO)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "secret": "__GLITCHTIP_CLIENT_SECRET__",
      "rootUrl": "https://glitchtip.open-bank.tech",
      "redirectUris": [
        "http://localhost:8000/*",
        "https://glitchtip.open-bank.tech/*"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "https://glitchtip.open-bank.tech"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ]
    },
    {
      "clientId": "argocd",
      "name": "ArgoCD (SSO)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "secret": "__ARGOCD_CLIENT_SECRET__",
      "redirectUris": ["https://localhost:8080/auth/callback", "http://localhost:8080/auth/callback"],
      "webOrigins": ["https://localhost:8080", "http://localhost:8080"],
      "defaultClientScopes": ["openid", "profile", "email", "roles"],
      "protocolMappers": [
        {
          "name": "realm-roles-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "groups",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "goalert",
      "name": "GoAlert (SSO)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "secret": "__GOALERT_CLIENT_SECRET__",
      "redirectUris": ["http://localhost:8081/v1/identity/providers/oidc/callback"],
      "webOrigins": ["http://localhost:8081"],
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    },
    {
      "clientId": "apicurio-registry",
      "name": "Apicurio Registry (SSO)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:8082/*"],
      "webOrigins": ["http://localhost:8082"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    },
    {
      "clientId": "openbao",
      "name": "OpenBao (SSO)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "secret": "__OPENBAO_CLIENT_SECRET__",
      "redirectUris": ["http://localhost:8200/ui/vault/auth/oidc/oidc/callback", "http://localhost:8250/oidc/callback"],
      "webOrigins": ["http://localhost:8200"],
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    }
  ],
  "clientScopeMappings": {
    "openbank-edge": [
      {
        "client": "openbank-edge",
        "roles": [
          "ROLE_OPERATOR"
        ]
      }
    ]
  },
  "users": [
    {
      "username": "admin@openbank.local",
      "email": "admin@openbank.local",
      "firstName": "Admin",
      "lastName": "OpenBank",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "__ADMIN_USER_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ROLE_ADMIN",
        "ROLE_OPERATOR",
        "ROLE_VIEWER"
      ]
    },
    {
      "username": "demo@openbank.local",
      "email": "demo@openbank.local",
      "firstName": "Demo",
      "lastName": "OpenBank",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "__DEMO_USER_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ROLE_VIEWER",
        "ROLE_DEMO"
      ]
    },
    {
      "username": "compliance@openbank.local",
      "email": "compliance@openbank.local",
      "firstName": "Compliance",
      "lastName": "OpenBank",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "__COMPLIANCE_USER_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ROLE_COMPLIANCE",
        "ROLE_VIEWER"
      ]
    },
    {
      "username": "compliance2@openbank.local",
      "email": "compliance2@openbank.local",
      "firstName": "Compliance Two",
      "lastName": "OpenBank",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "__COMPLIANCE2_USER_PASSWORD__",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ROLE_COMPLIANCE",
        "ROLE_VIEWER"
      ]
    },
    {
      "username": "service-account-openbank-edge",
      "enabled": true,
      "serviceAccountClientId": "openbank-edge",
      "realmRoles": [
        "ROLE_OPERATOR"
      ]
    },
    {
      "username": "service-account-openbank-services",
      "enabled": true,
      "serviceAccountClientId": "openbank-services",
      "realmRoles": [
        "ROLE_API"
      ]
    },
    {
      "username": "service-account-openbank-mcp-service",
      "enabled": true,
      "serviceAccountClientId": "openbank-mcp-service",
      "realmRoles": []
    }
  ]
}
