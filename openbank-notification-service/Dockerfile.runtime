# Runtime-only image for the T2 KEDA pilot (ADR-0057). The Quarkus fast-jar is
# built on the host (arch-independent Java bytecode) and packaged into an arm64
# JRE base for the Graviton nodes. Build context MUST be the service's
# build/quarkus-app directory:
#   docker buildx build --platform linux/arm64 \
#     -f openbank-notification-service/Dockerfile.runtime \
#     openbank-notification-service/build/quarkus-app
#
# NB: the committed multi-stage Dockerfile copies the repo-root settings.gradle.kts
# (which `include(...)`s every service) and breaks under Gradle 9.5.1, which no
# longer tolerates configuring an absent project dir. Fixing that for in-Docker
# builds is a separate follow-up; this runtime image unblocks the pilot now.
FROM eclipse-temurin:25-jre-ubi10-minimal@sha256:6031e5480f5d5818252a348980a192af0eab09e3380a55f75927e019f4d8136c
WORKDIR /app
# Explicit numeric UID/GID so a pod with runAsNonRoot can verify non-root without
# a runAsUser override (kubelet cannot resolve a named user from the image).
RUN groupadd -r -g 1001 openbank && useradd -r -u 1001 -g openbank openbank
USER 1001
COPY lib/ /app/lib/
COPY *.jar /app/
COPY app/ /app/app/
COPY quarkus/ /app/quarkus/
EXPOSE 8112
ENTRYPOINT ["java", "-XX:+UseZGC", "-Djava.util.logging.manager=org.jboss.logmanager.LogManager", "-jar", "/app/quarkus-run.jar"]
