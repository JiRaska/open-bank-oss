<?xml version="1.0" encoding="UTF-8"?>
<!--
  ISO 20022 pacs.004.001.09 — PaymentReturn (FI-to-FI payment return / R-transaction)

  PROVENANCE / STATUS (ADR-0104)
  ==============================
  Structurally-faithful WORKING SUBSET of the official ISO 20022 pacs.004.001.09 schema,
  vendored so the rail's / simulator's return message can be built and XSD-validated with zero
  external dependencies (JDK JAXP only). Not the full official schema — models the message tree,
  namespace and constrained types for the return fields actually populated (original references,
  returned amount, return reason). See pacs.008.001.08.xsd for the swap-in TODO that applies here.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:iso:std:iso:20022:tech:xsd:pacs.004.001.09"
           targetNamespace="urn:iso:std:iso:20022:tech:xsd:pacs.004.001.09"
           elementFormDefault="qualified">

  <xs:element name="Document" type="Document"/>

  <xs:complexType name="Document">
    <xs:sequence>
      <xs:element name="PmtRtr" type="PaymentReturnV09"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PaymentReturnV09">
    <xs:sequence>
      <xs:element name="GrpHdr" type="GroupHeader90"/>
      <xs:element name="TxInf" type="PaymentTransaction112" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="GroupHeader90">
    <xs:sequence>
      <xs:element name="MsgId" type="Max35Text"/>
      <xs:element name="CreDtTm" type="ISODateTime"/>
      <xs:element name="NbOfTxs" type="Max15NumericText"/>
      <xs:element name="SttlmInf" type="SettlementInstruction7"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SettlementInstruction7">
    <xs:sequence>
      <xs:element name="SttlmMtd" type="SettlementMethod1Code"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PaymentTransaction112">
    <xs:sequence>
      <xs:element name="RtrId" type="Max35Text" minOccurs="0"/>
      <xs:element name="OrgnlEndToEndId" type="Max35Text" minOccurs="0"/>
      <xs:element name="OrgnlTxId" type="Max35Text" minOccurs="0"/>
      <xs:element name="RtrdIntrBkSttlmAmt" type="ActiveCurrencyAndAmount"/>
      <xs:element name="RtrRsnInf" type="PaymentReturnReason6" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PaymentReturnReason6">
    <xs:sequence>
      <xs:element name="Rsn" type="ReturnReason5Choice"/>
      <xs:element name="AddtlInf" type="Max105Text" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ReturnReason5Choice">
    <xs:sequence>
      <xs:element name="Cd" type="ExternalReturnReason1Code"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ActiveCurrencyAndAmount">
    <xs:simpleContent>
      <xs:extension base="ActiveCurrencyAndAmount_SimpleType">
        <xs:attribute name="Ccy" type="ActiveCurrencyCode" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:simpleType name="ActiveCurrencyAndAmount_SimpleType">
    <xs:restriction base="xs:decimal">
      <xs:fractionDigits value="5"/>
      <xs:totalDigits value="18"/>
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Max35Text">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="35"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Max105Text">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="105"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Max15NumericText">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{1,15}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ISODateTime">
    <xs:restriction base="xs:dateTime"/>
  </xs:simpleType>

  <xs:simpleType name="ActiveCurrencyCode">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]{3,3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SettlementMethod1Code">
    <xs:restriction base="xs:string">
      <xs:enumeration value="INDA"/>
      <xs:enumeration value="INGA"/>
      <xs:enumeration value="COVE"/>
      <xs:enumeration value="CLRG"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ExternalReturnReason1Code">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="4"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
